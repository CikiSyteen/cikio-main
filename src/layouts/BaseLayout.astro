---
import { ClientRouter } from "astro:transitions";
import DesktopNavbar from "@components/DesktopNavbar.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Navbar from "@components/Navbar.astro";
import Sidebar from "@components/Sidebar.astro";
import MobileTOC from "@components/widgets/MobileTOC.astro";
import {
  SITE_DESCRIPTION,
  SITE_FAVICON,
  SITE_LANGUAGE,
  SITE_TAB,
  SITE_THEME,
  t,
  USER_NAME,
  USER_SITE,
} from "@config";
import ElementCrossing from "astro-vtbot/components/ElementCrossing.astro";
import PointerOnNavigation from "astro-vtbot/components/PointerOnNavigation.astro";

const {
  title,
  image,
  description = SITE_DESCRIPTION,
  headings = [],
  showTOC = false,
  isIndexed = true,
  ogType = "website",
  pubDate,
  // 首页等需要「全宽单列」的页面可隐藏侧栏；默认 false，保持既有的侧栏 + 内容双列布局
  hideSidebar = false,
  // 沉浸式 hero 版式：隐含收起侧栏、不渲染站点页脚（页面自己给一个更轻的），
  // 并在 body 上打 .hero-page 标记，供 global.scss 把顶部导航改写成浮在壁纸上的胶囊。
  hero = false,
} = Astro.props;

// hero 页面天然不需要侧栏：首页的「站点导航」小组件与侧栏的分类/标签/菜单是重复信息
const showSidebar = !hideSidebar && !hero;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd =
  ogType === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        image,
        url: pageUrl,
        datePublished: pubDate?.toISOString(),
        author: {
          "@type": "Person",
          name: USER_NAME,
        },
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE_TAB,
        url: USER_SITE,
        description: SITE_DESCRIPTION,
      };
---

<!doctype html>
<html lang={SITE_LANGUAGE} class="bg-base-300" data-theme={SITE_THEME.light} data-theme-type="light">
  <head>
    <ClientRouter />
    <ElementCrossing />
    <PointerOnNavigation />
    <Header
      title={title}
      description={description}
      favicon={SITE_FAVICON}
      image={image}
      ogType={ogType}
    />
    <title>{`${title} - ${SITE_TAB}`}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <script define:vars={{ SITE_THEME }} is:inline>
      (function () {
        // theme 存的是**模式**（light / dark / auto），不再是 daisyUI 主题名；
        // 兼容旧值：以前存的 "winter"/"dracula" 会被迁移成对应的 light/dark
        const readMode = () => {
          const stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark" || stored === "auto") return stored;
          if (stored === SITE_THEME.light) return "light";
          if (stored === SITE_THEME.dark) return "dark";
          return "auto";
        };

        // 当前模式最终应落的主题名（data-theme）与明暗（data-theme-type）
        const resolveTheme = () => {
          const mode = readMode();
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const type = mode === "auto" ? (prefersDark ? "dark" : "light") : mode;
          return { mode, type, theme: type === "dark" ? SITE_THEME.dark : SITE_THEME.light };
        };

        // 只写属性、不读 DOM，因此也能作用在「即将换上的新文档」上
        const applyTheme = (root) => {
          const { theme, type } = resolveTheme();
          root.setAttribute("data-theme", theme);
          root.setAttribute("data-theme-type", type);
        };

        // 首次加载：赶在样式计算之前把主题落到 <html>，避免默认（浅色）主题先闪一下
        const initial = resolveTheme();
        applyTheme(document.documentElement);
        localStorage.setItem("theme", initial.mode);

        // 站内换页：新文档的 <html> 带的是服务端渲染的默认主题（浅色），而 swap 时
        // swapRootAttributes 会把新文档的 <html> 属性整体套用到当前文档上 ——
        // 若等 astro:after-swap 再改回来，浏览器已经按浅色算过一遍样式、视图过渡也
        // 据此拍下了「新」快照，于是出现「按钮先浅后深」的闪烁。
        // 因此在 swap 之前就把主题写进新文档，套用过来的直接就是正确主题。
        document.addEventListener("astro:before-swap", (event) => {
          applyTheme(event.newDocument.documentElement);
        });

        // 兜底：万一某次换页没走到上面的分支（或主题被别的脚本覆盖），交换后再校正一次
        document.addEventListener("astro:after-swap", () => {
          if (document.documentElement.getAttribute("data-theme") !== resolveTheme().theme) {
            applyTheme(document.documentElement);
          }
        });

        // 跟随系统：仅 auto 模式响应系统配色变化
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (readMode() !== "auto") return;
          document.documentElement.setAttribute(
            "data-theme",
            e.matches ? SITE_THEME.dark : SITE_THEME.light,
          );
          document.documentElement.setAttribute("data-theme-type", e.matches ? "dark" : "light");
        });
      })();
    </script>
  </head>

  <body
    class:list={["flex flex-col min-h-screen", hero && "hero-page"]}
    {...isIndexed ? { "data-pagefind-body": true } : {}}
  >
    <!--
      页面级固定层（全屏背景壁纸、右上角悬浮控件）挂在这里、而不是放进内容区：
      它们用 position: fixed，而 fixed 的包含块会被**任何带 transform 的祖先**接管。
      内容区外层的 .onload-animation 恰好靠 transform 做入场动画且 fill-mode 为 forwards、
      那个 transform 会一直保留，留在里面的话 fixed 元素会被压缩到内容列范围内
      （首页实测：壁纸被压成导航下方的一个方框、齿轮跑到了内容区右上角）。
      放在 body 下才是真正的视口级固定层。
    -->
    <slot name="overlay" />

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:btn focus:btn-primary"
    >
      {t("label.skipToContent")}
    </a>

    <Navbar />
    <!-- 桌面端顶部栏；移动端由上面的 Navbar 负责，两者互斥（md 断点） -->
    <DesktopNavbar />

    <!--
      容器与栅格对齐 Fuwari：
        容器 max-w 75rem（原 max-w-6xl = 72rem）
        栅格 lg 以上为「17.5rem 侧栏 + 自适应内容区」（原为 4 等分栅格、侧栏占 1/4）
        lg 以下单列，内容在前、侧栏在后（与 Fuwari 一致）
    -->
    <!-- 顶部栏在文档流内、占据栅格上方的空间，因此无需任何偏移补偿 -->
    <div class="max-w-[75rem] mx-auto w-full flex-grow">
      <div
        class:list={[
          "grid grid-cols-1 gap-4 p-4 h-full items-start",
          showSidebar && "lg:grid-cols-[17.5rem_minmax(0,1fr)]",
        ]}
      >
        <main
          id="main-content"
          tabindex="-1"
          class:list={[
            "col-span-1 min-w-0 bg-transparent order-1 lg:order-2 flex flex-col gap-4",
            // hero 页面顶部是浮在壁纸上的胶囊导航：桌面端导航本身在文档流里占 5rem，
            // 再留 mt-24 会把首屏推得偏低，这里统一收到 5rem。
            hero ? "mt-20" : "mt-16 md:mt-0",
          ]}
        >
          <div class="onload-animation flex-grow flex flex-col gap-4">
            <slot />
          </div>
          <!-- hero 页面自带更轻的页脚（一行社交 + 版权），不叠通栏的站点页脚 -->
          {!hero && <Footer />}
        </main>
        <!--
          侧栏列在 lg 下用 self-stretch 撑到与内容列同高：
          目录卡片的吸附（sticky）只能在「包含块内」移动，包含块高度不足时吸附等于失效。
          撑满后目录才有足够的行程从页面下方一路跟到文章结束。
          showSidebar 为 false 时整列不渲染（首页用它换出整行来铺小组件网格）。
        -->
        {
          showSidebar && (
            <aside class="col-span-1 w-full lg:w-[17.5rem] lg:max-w-[17.5rem] lg:self-stretch bg-transparent order-2 lg:order-1">
              <Sidebar headings={headings} showTOC={showTOC} />
              <slot name="sidebar" />
            </aside>
          )
        }
      </div>
    </div>

    <MobileTOC headings={headings} showTOC={showTOC} />

    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        document.querySelectorAll(".btn-copy").forEach((button) => {
          button.addEventListener("click", async () => {
            const codeBlock = button.closest(".frosti-code");
            const code = codeBlock.querySelector("code").textContent;
            const copyIcon = button.querySelector(".frosti-code-toolbar-copy-icon");
            const successIcon = button.querySelector(".frosti-code-toolbar-copy-success");
            try {
              await navigator.clipboard.writeText(code);
              copyIcon.classList.add("hidden");
              successIcon.classList.remove("hidden");
              button.classList.add("copy-success");
              setTimeout(() => {
                copyIcon.classList.remove("hidden");
                successIcon.classList.add("hidden");
                button.classList.remove("copy-success");
              }, 2000);
            } catch (err) {
              console.error("Failed to copy:", err);
            }
          });
        });
      });
    </script>

    <style is:inline>
      .btn-copy {
        position: relative;
        overflow: hidden;
      }
      .copy-success {
        animation: pulse 0.5s ease-in-out;
      }
      .frosti-code-toolbar-copy-success svg {
        color: #10b981;
      }
      @keyframes pulse {
        0% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.1);
        }
        100% {
          transform: scale(1);
        }
      }
    </style>
  </body>
</html>

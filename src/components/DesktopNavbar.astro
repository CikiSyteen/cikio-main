---
/**
 * 桌面端顶部导航栏 —— 与 Fuwari 的顶部栏同形
 *
 * 背景：Frosti 原本只有移动导航栏（Navbar.astro 的 class 带 md:hidden），
 * 桌面端导航完全由左侧栏承担。这里补一条桌面顶部栏：
 *   - sticky 吸顶，高度 4.5rem，卡片底色 + 仅下缘圆角，带阴影
 *   - 左侧站名（主色图标 + 站点标题）
 *   - 中间菜单（带 subItems 的项用 hover 下拉）
 *   - 右侧搜索入口 + 主题切换
 *   - 宽度与页面栅格一致（75rem 容器 + 16px 内边距）
 *
 * 移动端不渲染，仍由原 Navbar.astro 负责。
 */
import { Icon } from "astro-icon/components";
import { SITE_MENU, SITE_TITLE, t } from "../config";
import ThemeToggle from "./widgets/ThemeToggle.astro";

const currentPath = Astro.url.pathname;

type SubMenuItem = {
  id: string;
  text: string;
  href: string;
  svg: string;
  target?: string;
};

type MenuItem = SubMenuItem & {
  subItems?: SubMenuItem[];
};

const menu = SITE_MENU as MenuItem[];

// 首页只在完全相等时高亮，其余按前缀匹配（子页面也保持高亮）
const isActive = (href: string) =>
  href.startsWith("http") || href.startsWith("mailto:")
    ? false
    : currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<!--
  顶部导航栏 = 文档流内的普通页面元素（static，不加任何定位）。
  它随页面一起滚动，滚出视口后就不再跟随 —— 即「作为页面一个固定元素」，
  而不是「一直跟随用户滚动显示」。

  注意：不要改回 sticky 或 fixed。两者都会让它在滚动过程中持续停留在视口里：
  sticky 贴住视口顶部跟随滚动，fixed 按浏览器窗口定位并脱离文档流（会盖住内容，
  还要给内容补偏移，即此前出现过的 md:pt-[4.5rem]）。
-->
<header class="hidden md:block">
  <!--
    desktop-navbar-shell / -bar 两个类只作为可选的作用域钩子：
    默认外观完全不变（通栏白条），只有首页那种沉浸式 hero 版式
    （BaseLayout 的 hero 属性 → body 上的 .hero-page）才会把这条通栏
    改写成浮在壁纸上的居中胶囊，见 global.scss 的「首页 hero 版式」。
  -->
  <div class="desktop-navbar-shell max-w-[75rem] mx-auto w-full px-4">
    <div
      class="desktop-navbar-bar bg-base-100 shadow-lg rounded-b-xl h-[4.5rem] flex items-center justify-between px-4"
    >
      <!--
        站名：纯展示，不可点击、也没有 hover 交互。
        它原来是回首页的链接 + hover:scale-105，但菜单里已经有「首页」，
        回首页的入口不缺这一个；顶栏最左侧留一块会放大的可点区域，反而让人以为
        那是当前页标记而不是按钮。

        用 div 而不是"去掉 href 的 a"或 span：后者仍会进 tab 序列 / 被读屏当成可交互元素，
        div 天然不可聚焦、无 role。布局用手写 flex 顶替原来的 .btn（尺寸与内边距逐项对齐），
        这样去掉 .btn 后不会连带丢掉它的 hover 底色与 cursor:pointer。
      -->
      <div class="flex h-[3.25rem] items-center px-5 text-xl font-bold">
        <span class="flex flex-row items-center text-primary">
          <Icon name="lucide:house" class="mb-1 mr-2 text-[1.75rem]" aria-hidden="true" />
          <span>{SITE_TITLE}</span>
        </span>
      </div>

      <!-- 菜单 -->
      <nav class="flex items-center gap-1" aria-label={SITE_TITLE}>
        {
          menu.map((item) =>
            item.subItems ? (
              <div class="dropdown dropdown-hover">
                <div
                  tabindex="0"
                  role="button"
                  class:list={[
                    "btn btn-ghost h-11 px-5 text-base font-bold",
                    isActive(item.href) && "text-primary",
                  ]}
                >
                  <span>{item.text}</span>
                  <Icon name="lucide:chevron-down" class="w-4 h-4 ml-1" />
                </div>
                <!--
                  关键：面板与触发按钮之间**不能有外边距**。
                  外边距会形成一段既不属于按钮、也不属于面板的空隙，
                  光标从「博客」移向子项时 hover 判定丢失，菜单就会闪退。
                  这里改为在面板外层加透明的 pt-2 —— 视觉上仍有间隙，但可悬停区是连续的。
                -->
                <div tabindex="0" class="dropdown-content z-50 pt-2 w-44">
                  <ul class="menu bg-base-100 rounded-box shadow-lg p-2 w-full">
                    {item.subItems.map((subItem) => (
                      <li>
                        <a
                          href={subItem.href}
                          target={subItem.target || "_self"}
                          aria-current={currentPath === subItem.href ? "page" : undefined}
                          class:list={[currentPath === subItem.href && "active"]}
                        >
                          {subItem.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                target={item.target || "_self"}
                aria-current={currentPath === item.href ? "page" : undefined}
                class:list={[
                  "btn btn-ghost h-11 px-5 text-base font-bold",
                  isActive(item.href) && "text-primary",
                ]}
              >
                {item.text}
              </a>
            ),
          )
        }
      </nav>

      <!-- 右侧功能区：搜索输入框 + 主题切换 -->
      <div class="flex items-center gap-2 shrink-0">
        <form id="navbar-search" action="/blog/search" method="get" role="search" class="relative">
          <input
            type="search"
            name="q"
            placeholder={t("label.searchPlaceholder") || "搜索…"}
            aria-label={t("label.search") || "搜索"}
            class="input input-bordered h-10 w-32 lg:w-44 xl:w-56 rounded-full pl-9 pr-3 text-sm"
          />
          <Icon
            name="lucide:search"
            class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-base-content/50"
          />
        </form>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script>
  import { navigate } from "astro:transitions/client";

  // 表单默认提交会整页刷新，这里改用客户端路由，保留页面过渡动画
  document.addEventListener("submit", (e) => {
    const form = (e.target as HTMLElement | null)?.closest?.("#navbar-search");
    if (!form) return;

    e.preventDefault();
    const input = form.querySelector('input[name="q"]') as HTMLInputElement | null;
    const q = input?.value.trim();
    if (!q) {
      input?.focus();
      return;
    }
    navigate(`/blog/search?q=${encodeURIComponent(q)}`);
  });

  // 按 "/" 聚焦顶栏搜索框（该快捷键原先在侧栏搜索卡片里，随搜索框一起搬过来）
  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement | null;
    if (e.key !== "/" || !target) return;
    if (
      target.tagName === "INPUT" ||
      target.tagName === "TEXTAREA" ||
      target.isContentEditable
    )
      return;

    const input = document.querySelector<HTMLInputElement>(
      '#navbar-search input[name="q"]',
    );
    if (!input) return;

    e.preventDefault();
    input.focus();
  });
</script>

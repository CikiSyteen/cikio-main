---
import type { HomeQuoteItem } from "@interfaces/site";
import { Icon } from "astro-icon/components";
import WidgetCard from "./WidgetCard.astro";

/**
 * 「一言」卡片。
 *
 * 内容池来自 config/home.quotes.yaml 的 items（留空则整张卡不渲染）。
 * 服务端先渲染第一条，客户端接管后按轮换方式决定显示哪一条 ——
 * 轮换方式的默认值来自配置，访客可以用右上角齿轮面板覆盖（存 localStorage）。
 * 四种方式（不轮换 / 每日 / 每次刷新 / 每 N 秒）的定义与解析见 @utils/homeRotation。
 *
 * 换一条用「换一条」按钮手动触发；按钮放在标题栏右上角（WidgetCard 的 actions 插槽），
 * 不再占用正文高度。
 *
 * 卡片只展示正文，不再展示作者 —— 省下的整行（作者行 24px + gap-3 12px）全部让给正文，
 * 正文区从约 50px 涨到 86px，正好放得下 3 行 text-sm/leading-relaxed（68.25px）。
 *
 * 正文刻意不加 text-balance：它会把每行压到「刚好不折行」的宽度，行尾留出一片空白，
 * 看上去就像提前断句。浏览器默认换行会把每行填满，同样的字数更省行。
 *
 * 卡片的尺寸仍由 index.astro 固定（sm:h-[10.5rem]），请按 3 行 ≈ 50 字控制单条长度。
 */

export interface RandomQuoteWidgetProps {
  quotes: HomeQuoteItem[];
  /** 默认轮换方式，取值见 @utils/homeRotation */
  mode: string;
  class?: string;
}

const {
  quotes,
  mode,
  class: className = "",
} = Astro.props as RandomQuoteWidgetProps;

// 没有配置内容时由 index.astro 决定整张卡不渲染；
// 这里只把首条取出来做服务端首屏，取不到就渲染空文本。
const first = quotes[0];
---

<WidgetCard id="home-quote" title="一言" icon="lucide:quote" class={className}>
  <button
    slot="actions"
    type="button"
    data-quote-next
    class="btn btn-ghost btn-xs shrink-0 gap-1 text-base-content/70 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60"
  >
    <Icon name="lucide:refresh-cw" class="h-3.5 w-3.5" aria-hidden="true" />
    <span>换一条</span>
  </button>

  <blockquote data-quote-text class="text-sm leading-relaxed text-base-content/85">
    {first?.text ?? ""}
  </blockquote>
</WidgetCard>

<script
  type="application/json"
  data-quote-data
  is:inline
  set:html={JSON.stringify({ quotes: quotes.map((item) => item.text), mode })}
></script>

<script>
  import { dailyRotationIndex, parseRotation } from "@utils/homeRotation";

  const SETTINGS_KEY = "cikio-home-settings";

  let timer: number | undefined;
  // 模块级变量在同一次会话内跨站内换页保留，用来避免连续抽到同一条
  let lastIndex = -1;

  interface QuotePayload {
    /** 只传正文；作者字段已不再展示，不必下发到客户端 */
    quotes: string[];
    mode: string;
  }

  function readPayload(): QuotePayload | null {
    const element = document.querySelector<HTMLScriptElement>("[data-quote-data]");
    if (!element?.textContent) return null;
    try {
      return JSON.parse(element.textContent);
    } catch {
      return null;
    }
  }

  /**
   * 一言统一按「每次刷新随机一条」处理，不再提供轮换设置项。
   * 手动「换一条」也能继续用，逻辑在 initQuote 里。
   */
  function pickIndex(total: number): number {
    if (total <= 1) return 0;
    let index = lastIndex;
    // 连续两次抽到同一条会让人以为没生效，重抽到不同为止
    while (index === lastIndex) {
      index = Math.floor(Math.random() * total);
    }
    lastIndex = index;
    return index;
  }

  function applyQuote(payload: QuotePayload, index: number): void {
    const text = payload.quotes[index];
    if (!text) return;

    const textElement = document.querySelector("[data-quote-text]");
    if (textElement) textElement.textContent = text;
  }

  function initQuote(): void {
    const payload = readPayload();
    if (!payload || payload.quotes.length === 0) return;

    const total = payload.quotes.length;
    const rotation = parseRotation("refresh");

    window.clearInterval(timer);
    timer = undefined;

    // 「不轮换」固定第一条；「每日」取当天对应的那条；「每次刷新」与定时模式先随机一条
    let shown: number;
    if (rotation.kind === "none") shown = 0;
    else if (rotation.kind === "daily") shown = dailyRotationIndex(new Date(), total);
    else shown = pickIndex(total);

    // 记下当前这一条：手动「换一条」靠它避免又抽到同一条
    lastIndex = shown;
    applyQuote(payload, shown);

    if (rotation.kind === "timer" && rotation.seconds > 0) {
      timer = window.setInterval(() => applyQuote(payload, pickIndex(total)), rotation.seconds * 1000);
    }

    const button = document.querySelector<HTMLButtonElement>("[data-quote-next]");
    if (button) {
      button.onclick = () => applyQuote(payload, pickIndex(total));
    }
  }

  document.addEventListener("astro:page-load", initQuote);
  // 齿轮面板改了轮换方式后立即按新方式重排
  window.addEventListener("cikio:home-settings", initQuote);
</script>

---
import type { HomeBackgroundItem } from "@interfaces/site";
import { ROTATION_OPTIONS } from "@utils/homeRotation";
import { Icon } from "astro-icon/components";

/**
 * 首页右上角的齿轮设置面板。
 *
 * 只出现在首页（hero 版式），站内其它页面不渲染。
 * 能改三件事：背景图、一言轮换方式、背景轮换方式。
 *
 * 面板是居中弹窗（原生 <dialog> + showModal）而不是原先的下拉菜单：
 * 下拉浮在 hero 版式里，内容一多就贴着视口边、也会和浮动的胶囊导航打架；
 * 弹窗有原生遮罩把注意力收进来，Esc 关闭、焦点收束、遮罩点击关闭全部由浏览器负责。
 *
 * 全部存在 localStorage 的 `cikio-home-settings` 里，不改服务端任何东西 ——
 * 也就是说每个访客看到的是自己选的画面。改完通过 `cikio:home-settings`
 * 自定义事件通知壁纸层与一言卡片即时生效（它们之间不共享模块作用域，
 * 组件各自的 script 块会被打包成独立文件，只能靠 window 上的事件通信）。
 *
 * 注意：本文件的注释里禁止出现尖括号形式的 script 标签字面量。Vite 的依赖扫描
 * 会把它当成真实脚本标签，把后面的中文当代码解析并抛 PARSE_ERROR，导致整个 dev
 * 环境的依赖预构建被跳过（表现为依赖退回按需加载、CJS 包在浏览器端报错）。
 *
 * 候选值与默认值来自 config/home.background.yaml，所以"默认长什么样"是站点拥有者说了算。
 */

export interface HomeSettingsProps {
  backgrounds: HomeBackgroundItem[];
  defaultBackground: string;
}

// 必须显式断言：Astro.props 的类型是 Record<string, any>，不写 as 的话
// 所有 prop 都会退化成 any（上面导出的 HomeSettingsProps 就成了死代码）。
// 缺省值只是运行时兜底：prop 缺失时退化为"没有可选背景"，而不是在
// backgrounds.length 处抛错。
const { backgrounds = [], defaultBackground = "" } =
  Astro.props as HomeSettingsProps;

const defaults = {
  bg: defaultBackground,
};

/** 本地静态图（有 path）与动态壁纸（有 url，必应今日/随机）分开渲染 */
const localBackgrounds = backgrounds.filter((item) => item.path);
const dynamicBackgrounds = backgrounds.filter((item) => item.url);

/**
 * 动态壁纸的弹窗缩略图：复用接口的 w/h 参数拉小图，避免为了预览下载 1080p。
 * 注意必应 th 端点只为 16:9 标准尺寸生成派生图（640x360 可用），
 * 其它比例（如 480x300、480x270）会 404，这里不能随意改尺寸。
 */
const thumbOfUrl = (url: string, w: number, h: number) =>
  url.replace(/([?&])w=\d+/, `$1w=${w}`).replace(/([?&])h=\d+/, `$1h=${h}`);
const isRandom = (item: HomeBackgroundItem) => item.id.endsWith("random");
---

<!--
  外壳不带任何定位：里面的齿轮是 fixed、弹窗走 <dialog> 的 top layer，
  两者都以视口为参照。若给外壳加 transform 之类的东西，会把它们的包含块劫持掉。
-->
<div data-home-settings>
  <!-- 固定在视口右上角；移动端下移到导航胶囊下方（胶囊占满宽度，会盖住 top-4 的位置） -->
  <div class="hidden md:block fixed right-5 top-5 z-40">
    <button
      type="button"
      data-home-settings-open
      aria-haspopup="dialog"
      aria-label="首页设置"
      class="home-tile home-settings-toggle btn btn-circle h-11 w-11 min-h-0 border-0"
    >
      <Icon name="lucide:settings" class="h-5 w-5 text-base-content/80" aria-hidden="true" />
    </button>
  </div>

  <!-- 居中放大 + 遮罩式弹窗，外观与动画见 global.scss 的 .home-settings-dialog -->
  <dialog
    class="home-settings-dialog"
    data-home-settings-dialog
    aria-labelledby="home-settings-title"
  >
    <div
      class="home-settings-panel flex w-full flex-col overflow-hidden rounded-2xl border border-base-300/50 bg-base-100 shadow-2xl"
    >
      <!-- 青柠起始页式页头：标题居中，关闭钮绝对定位在右侧 -->
      <header class="relative flex items-center justify-center border-b border-base-300/50 px-12 py-3.5">
        <h2 id="home-settings-title" class="text-sm font-bold">首页设置</h2>
        <button
          type="button"
          data-home-settings-close
          aria-label="关闭设置"
          class="btn btn-ghost btn-sm btn-circle absolute right-2.5 text-base-content"
        >
          <Icon name="lucide:x" class="h-4 w-4" aria-hidden="true" />
        </button>
      </header>

      <div class="flex flex-col gap-4 px-5 pt-4 pb-4">
        {
          localBackgrounds.length > 0 && (
            <section>
              <h3 class="mb-2 text-xs font-medium text-base-content/60">默认</h3>
              <div class="grid grid-cols-3 gap-2 sm:grid-cols-5">
                {localBackgrounds.map((item) => (
                  <label class="relative block cursor-pointer" title={item.name}>
                    <input
                      type="radio"
                      name="home-background"
                      value={item.id}
                      class="peer sr-only"
                      data-home-bg-option
                    />
                    <img
                      src={`${item.path}-960.webp`}
                      alt={item.name}
                      width="960"
                      height="640"
                      loading="lazy"
                      class="aspect-[3/2] w-full rounded-lg object-cover ring-2 ring-transparent transition peer-checked:ring-primary peer-focus-visible:ring-primary"
                    />
                    <span class="pointer-events-none absolute right-1 bottom-1 hidden h-5 w-5 items-center justify-center rounded-full bg-base-100/95 text-primary shadow peer-checked:flex">
                      <Icon name="lucide:check" class="h-3.5 w-3.5" aria-hidden="true" />
                    </span>
                  </label>
                ))}
              </div>
            </section>
          )
        }

        {
          dynamicBackgrounds.length > 0 && (
            <section>
              <h3 class="mb-2 text-xs font-medium text-base-content/60">必应壁纸</h3>
              <div class="flex flex-col gap-2">
                {dynamicBackgrounds.map((item) => (
                  <label class="relative block cursor-pointer" title={item.name}>
                    <input
                      type="radio"
                      name="home-background"
                      value={item.id}
                      class="peer sr-only"
                      data-home-bg-option
                    />
                    <div class="flex items-center gap-3 rounded-lg border border-base-300/40 bg-base-200/40 p-2 ring-2 ring-transparent transition peer-checked:ring-primary peer-focus-visible:ring-primary">
                      {isRandom(item) ? (
                        <div class="flex h-14 w-24 shrink-0 items-center justify-center rounded-md bg-base-300/50">
                          <Icon name="lucide:shuffle" class="h-6 w-6 text-primary" aria-hidden="true" />
                        </div>
                      ) : (
                        <img
                          src={item.url ? thumbOfUrl(item.url, 640, 360) : ""}
                          alt={item.name}
                          width="320"
                          height="180"
                          loading="lazy"
                          class="h-14 w-24 shrink-0 rounded-md object-cover"
                        />
                      )}
                      <div class="min-w-0">
                        <p class="truncate text-sm font-semibold text-base-content">{item.name}</p>
                        <p class="truncate text-xs text-base-content/70">
                          {isRandom(item) ? "每次都换一张 · 来源必应" : "每天自动更新 · 来源必应"}
                        </p>
                      </div>
                    </div>
                    <span class="pointer-events-none absolute top-3 right-3 hidden h-5 w-5 items-center justify-center rounded-full bg-base-100/95 text-primary shadow peer-checked:flex">
                      <Icon name="lucide:check" class="h-3.5 w-3.5" aria-hidden="true" />
                    </span>
                  </label>
                ))}
              </div>
            </section>
          )
        }

        <button
          type="button"
          class="btn btn-ghost btn-xs w-full text-base-content"
          data-home-settings-reset
        >
          恢复默认
        </button>
      </div>
    </div>
  </dialog>
</div>

<script
  type="application/json"
  data-home-settings-defaults
  is:inline
  set:html={JSON.stringify(defaults)}
></script>

<script>
  import { ROTATION_OPTIONS } from "@utils/homeRotation";

  const SETTINGS_KEY = "cikio-home-settings";

  interface HomeSettings {
    bg?: string;
    quoteMode?: string;
    bgMode?: string;
    /** 旧键：改动前存的是裸秒数，读的时候兜底，避免老访客的选择被静默重置 */
    quoteInterval?: number;
    bgInterval?: number;
  }

  function readSettings(): HomeSettings {
    try {
      return JSON.parse(window.localStorage.getItem(SETTINGS_KEY) || "{}");
    } catch {
      return {};
    }
  }

  function writeSettings(next: HomeSettings): void {
    try {
      window.localStorage.setItem(SETTINGS_KEY, JSON.stringify(next));
    } catch {
      // 隐私模式下 localStorage 不可写，忽略即可（本次会话仍会通过事件生效）
    }
  }

  function readDefaults(): { bg?: string } | null {
    const element = document.querySelector<HTMLScriptElement>("[data-home-settings-defaults]");
    if (!element?.textContent) return null;
    try {
      return JSON.parse(element.textContent);
    } catch {
      return null;
    }
  }

  /** 通知壁纸层与一言卡片按新设置重新渲染 */
  function broadcast(): void {
    window.dispatchEvent(new CustomEvent("cikio:home-settings"));
  }

  /**
   * 选中态一律按"字符串 + 兜底"写入。
   * 配置或老设置里可能出现候选列表之外的秒数（例如 45 秒），
   * 此时 select.value 会变成空串、面板看起来什么都没选中 —— 退回默认值，
   * 实际生效的值仍由各脚本自己解析，不受面板显示影响。
   */
  function setSelect(select: HTMLSelectElement | null, value: string, fallback: string): void {
    if (!select) return;
    select.value = value;
    if (!select.value) select.value = fallback;
    if (!select.value) select.value = ROTATION_OPTIONS[0].value;
  }

  // 查询一律限定在 root 内，与下面的绑定逻辑保持一致：
  // 用 document 级选择器的话，这个组件就不再是自包含的 ——
  // 将来若同时渲染两个实例（比如移动端另做一份），两个面板会互相覆盖选中态。
  function syncPanel(
    root: HTMLElement,
    defaults: { bg?: string },
    settings: HomeSettings,
  ): void {
    const background = settings.bg ?? defaults.bg ?? "";
    root.querySelectorAll<HTMLInputElement>("[data-home-bg-option]").forEach((input) => {
      input.checked = input.value === background;
    });
  }

  function initSettings(): void {
    // 这个脚本是全站打包的，每个页面的 astro:page-load 都会跑一遍，
    // 而面板只存在于首页。所以先判断面板是否存在，再去解析 defaults 的 JSON ——
    // 否则非首页的每次进入都会白做一次 querySelector + JSON.parse。
    const root = document.querySelector<HTMLElement>("[data-home-settings]");
    if (!root) return;

    const defaults = readDefaults();
    if (!defaults) return;

    syncPanel(root, defaults, readSettings());

    const dialog = root.querySelector<HTMLDialogElement>("[data-home-settings-dialog]");

    // showModal 在已打开时会抛 InvalidStateError；换页后 DOM 被替换，
    // 这里用 on* 赋值天然幂等，不会把同一个处理器叠好几层。
    // 设置触发按钮可能在组件内部（桌面端浮动按钮），也可能在移动端顶栏（Navbar 里的齿轮，
    // 它不在 [data-home-settings] 作用域内），所以按属性全局绑定，而非只查 root。
    const openButtons = document.querySelectorAll<HTMLButtonElement>("[data-home-settings-open]");
    openButtons.forEach((btn) => {
      btn.onclick = () => {
        if (dialog && !dialog.open) dialog.showModal();
      };
    });

    const closeButton = root.querySelector<HTMLButtonElement>("[data-home-settings-close]");
    if (closeButton && dialog) {
      closeButton.onclick = () => dialog.close();
    }

    if (dialog) {
      // 点遮罩关闭：遮罩上的点击事件 target 就是 dialog 本身
      // （面板在 dialog 内部，点它时 target 是里面的元素）。
      dialog.onclick = (event) => {
        if (event.target === dialog) dialog.close();
      };
    }

    root.querySelectorAll<HTMLInputElement>("[data-home-bg-option]").forEach((input) => {
      input.onchange = () => {
        if (!input.checked) return;
        writeSettings({ ...readSettings(), bg: input.value });
        broadcast();
      };
    });

    const resetButton = root.querySelector<HTMLButtonElement>("[data-home-settings-reset]");
    if (resetButton) {
      resetButton.onclick = () => {
        try {
          window.localStorage.removeItem(SETTINGS_KEY);
        } catch {
          /* 忽略 */
        }
        syncPanel(root, defaults, {});
        broadcast();
      };
    }
  }

  document.addEventListener("astro:page-load", initSettings);
</script>

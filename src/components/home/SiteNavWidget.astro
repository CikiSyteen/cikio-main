---
import { SITE_MENU } from "@config";
import { Icon } from "astro-icon/components";

/**
 * 站点导航：底部横向"工具带"（参考 type/62296d 的 lower-toolbelt-layer）。
 *
 * 刻意不再套 WidgetCard 外壳 —— 一条横贯内容区的通栏卡片会把壁纸拦腰截断，
 * 参考页的做法是"发光分隔线 + 一排等宽玻璃瓦片"，瓦片之间留着壁纸，
 * 整条带子只占一行的高度。
 *
 * 主入口直接取自 frosti.config.yaml 的 site.menu —— 与顶部导航同源，
 * 以后增删菜单项只改一处；首页自身那条（href 为 /）会被滤掉，避免自链接。
 * 其余是主菜单里没有、但访客常用的落点（归档 / 分类 / 标签 / 搜索 / 订阅）。
 */

export interface SiteNavWidgetProps {
  class?: string;
}

const { class: className = "" } = Astro.props as SiteNavWidgetProps;

const primaryItems = SITE_MENU.filter((item) => item.href !== "/").map(
  (item) => ({
    title: item.text,
    href: item.href,
    icon: item.svg || "lucide:link",
  }),
);

const secondaryItems = [
  { title: "全部文章", href: "/blog", icon: "lucide:book-open" },
  { title: "归档", href: "/blog/archives", icon: "lucide:archive" },
  { title: "分类", href: "/blog/categories", icon: "lucide:folder" },
  { title: "标签", href: "/blog/tags", icon: "lucide:tag" },
  { title: "搜索", href: "/blog/search", icon: "lucide:search" },
  { title: "订阅", href: "/rss.xml", icon: "lucide:rss" },
];
---

<section
  aria-labelledby="home-nav-title"
  class:list={["home-enter flex flex-col gap-4", className]}
>
  <!-- 工具带上缘的发光分隔线（62296d 的同名装饰，去掉发光只留渐隐） -->
  <div class="home-divider" aria-hidden="true"></div>

  <h2
    id="home-nav-title"
    class="flex items-center justify-center gap-2 text-sm font-semibold text-base-content/85"
  >
    <Icon name="lucide:compass" class="h-4 w-4 text-primary" aria-hidden="true" />
    <span class="home-hero-outline">站点导航</span>
  </h2>

  <!-- 瓦片等宽平铺一行；窄屏两列，不留"半行空洞" -->
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
    {
      primaryItems.map((item) => (
        <a
          href={item.href}
          class="home-tile group flex items-center gap-3 rounded-xl p-3.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60"
        >
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110">
            <Icon name={item.icon} class="h-5 w-5" aria-hidden="true" />
          </span>
          <span class="min-w-0 truncate text-sm font-medium">{item.title}</span>
        </a>
      ))
    }
  </div>

  <div class="flex flex-wrap justify-center gap-2">
    {
      secondaryItems.map((item) => (
        <a
          href={item.href}
          class="home-tile btn btn-ghost btn-sm gap-1.5 text-base-content/80 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60"
        >
          <Icon name={item.icon} class="h-4 w-4" aria-hidden="true" />
          <span>{item.title}</span>
        </a>
      ))
    }
  </div>
</section>

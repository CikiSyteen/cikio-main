---
import type { HomeHolidayMap } from "@interfaces/site";
import type { LunarTable } from "@utils/lunar";
import { Icon } from "astro-icon/components";
import WidgetCard from "./WidgetCard.astro";

/**
 * 月视图日历。
 *
 * 服务端只渲染骨架（表头 + 空的网格占位 + 图例 + 详情区），网格由客户端脚本按
 * "访客本地当前月"绘制 —— 静态站点在构建期渲染日历时只会画出构建当月的日历，那是错的。
 *
 * 尺寸恒定是这个组件的硬要求：卡片高度由 index.astro 固定，内部每一块也都给了
 * 固定高度 —— 网格用 min-height 占位、详情区一次性占满两行。这样脚本没跑之前
 * 与跑完之后尺寸完全一致，既不会跳布局，也不会出现"底下缺一块"的观感。
 *
 * 每格两行：上面是公历日，下面是农历 / 节假日状态。
 *  - 法定节假日：第一天显示节日名，其余显示「休」（红色）
 *  - 调休补班日：显示「班」（蓝色）
 *  - 其余：显示农历日（初一显示月份名）
 * 农历表与节假日表都在构建期算好、以 JSON 随页面下发，客户端只做下标查表：
 * 浏览器对非公历 Intl 的支持不可靠（Firefox 长期缺非公历 ICU 数据），
 * 而农历换算所需的历法数据又完全不值得为此引入一个库。
 *
 * 有更新的日期带圆点、可点击，点击后在下方列出当天的文章链接。
 */

export interface CalendarPost {
  title: string;
  url: string;
}

export interface CalendarWidgetProps {
  /** 形如 { "2026-09-25": [{ title, url }] } */
  postsByDate?: Record<string, CalendarPost[]>;
  /** 构建期生成的农历表 */
  lunar: LunarTable;
  /** 构建期展开的节假日 / 调休表 */
  holidays: HomeHolidayMap;
  class?: string;
}

const {
  postsByDate = {},
  lunar,
  holidays,
  class: className = "",
} = Astro.props as CalendarWidgetProps;

// 周一起始，与中文日历习惯一致
const WEEKDAY_LABELS = ["一", "二", "三", "四", "五", "六", "日"];
const payload = JSON.stringify({ postsByDate, lunar, holidays });
---

<WidgetCard
  id="home-calendar"
  title="日历"
  icon="lucide:calendar-days"
  href="/blog/archives"
  hrefLabel="归档"
  class={className}
>
  <!-- h-full + min-h-0：卡片高度固定时，让下面的网格区吃掉多余空间（见 grid 的 flex-1） -->
  <div data-calendar class="flex h-full min-h-0 flex-col gap-2">
    <div class="flex items-center justify-between gap-2">
      <button type="button" data-calendar-prev class="btn btn-ghost btn-xs" aria-label="上一个月">
        <Icon name="lucide:chevron-left" class="h-4 w-4" aria-hidden="true" />
      </button>
      <span data-calendar-label class="text-sm font-semibold">—</span>
      <button type="button" data-calendar-next class="btn btn-ghost btn-xs" aria-label="下一个月">
        <Icon name="lucide:chevron-right" class="h-4 w-4" aria-hidden="true" />
      </button>
    </div>

    <div class="grid grid-cols-7 gap-1 text-center text-[0.7rem] text-base-content/60">
      {WEEKDAY_LABELS.map((label) => <span>{label}</span>)}
    </div>

    <!--
      固定高度占位（6 行 × h-9 + 5 个 gap）：客户端绘制前就把位置占住，不会跳布局。
      flex-1 让它在卡片高度固定时吸收多余空间 —— 只写 min-h 的话，多出来的高度会
      全堆到卡片底部，日期网格反而被顶在上面。
    -->
    <div data-calendar-grid class="grid min-h-[14.75rem] flex-1 grid-cols-7 gap-1 text-center"></div>

    <p class="flex flex-wrap items-center justify-end gap-x-3 gap-y-1 text-[0.7rem] text-base-content/70">
      <span class="inline-flex items-center gap-1">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-primary"></span>
        <span>有更新</span>
      </span>
      <span class="text-error">休</span>
      <span class="calendar-work">班</span>
    </p>

    <!--
      固定两行高度，而不是原先的 min-h-[1.25rem]（一行）：
      服务端渲染时这里是空的，脚本跑完会填上「本月暂无更新 · 最近一次：2025-05-31 更新 1 篇：…」，
      通常正好两行。只占一行的话首屏先矮一块、数据到位再长高，既跳布局又像"缺了一块"。
      点开某天看到更多条目时（可能超过两行）改为内部滚动，卡片的尺寸始终不变。
    -->
    <div
      data-calendar-detail
      class="h-[2.4rem] overflow-y-auto text-[0.7rem] leading-relaxed"
    >
    </div>
  </div>
</WidgetCard>

<script type="application/json" data-calendar-data is:inline set:html={payload}></script>

<script>
  // 日历完全在客户端绘制：静态构建期算出来的"当月"是构建当月，对访客没有意义。
  interface CalendarPost {
    title: string;
    url: string;
  }

  interface HolidayDay {
    name: string;
    type: "rest" | "work";
    first: boolean;
  }

  interface CalendarPayload {
    postsByDate: Record<string, CalendarPost[]>;
    lunar: { start: string; days: string[] };
    holidays: Record<string, HolidayDay>;
  }

  const MILLISECONDS_PER_DAY = 24 * 60 * 60 * 1000;

  function initHomeCalendar(): void {
    const root = document.querySelector<HTMLElement>("[data-calendar]");
    if (!root) return;

    const payloadElement = document.querySelector<HTMLScriptElement>("[data-calendar-data]");
    let payload: CalendarPayload = {
      postsByDate: {},
      lunar: { start: "", days: [] },
      holidays: {},
    };
    try {
      if (payloadElement?.textContent) {
        payload = JSON.parse(payloadElement.textContent) as CalendarPayload;
      }
    } catch {
      /* 解析失败就用空数据，日历仍然能画出公历 */
    }

    const { postsByDate, lunar, holidays } = payload;

    // 先把农历表的起点换算成 UTC 毫秒，之后每天只做一次减法取下标。
    // 用 UTC 而不是本地时间做差：跨时区、夏令时都不会偏一天。
    const [startYear, startMonth, startDay] = (lunar.start || "1970-01-01")
      .split("-")
      .map(Number);
    const lunarStartUtc = Date.UTC(startYear, startMonth - 1, startDay);

    // 先收窄成非空常量再往下用：闭包里不会再走一遍外层的作用域收窄，
    // 直接把 HTMLElement | null 带进 render() 会报 "possibly null"。
    const gridNode = root.querySelector<HTMLElement>("[data-calendar-grid]");
    const labelNode = root.querySelector<HTMLElement>("[data-calendar-label]");
    if (!gridNode || !labelNode) return;
    const grid: HTMLElement = gridNode;
    const label: HTMLElement = labelNode;

    const detail = root.querySelector<HTMLElement>("[data-calendar-detail]");
    const prevButton = root.querySelector<HTMLButtonElement>("[data-calendar-prev]");
    const nextButton = root.querySelector<HTMLButtonElement>("[data-calendar-next]");

    const today = new Date();
    const todayKey = toKey(today.getFullYear(), today.getMonth(), today.getDate());
    let viewYear = today.getFullYear();
    let viewMonth = today.getMonth();

    function toKey(year: number, month: number, day: number): string {
      return `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
    }

    function lunarTextOf(year: number, month: number, day: number): string {
      if (lunar.days.length === 0) return "";
      const index = Math.round(
        (Date.UTC(year, month, day) - lunarStartUtc) / MILLISECONDS_PER_DAY,
      );
      return lunar.days[index] ?? "";
    }

    function clearDetail(): void {
      if (!detail) return;
      detail.textContent = "";
    }

    function showDetail(key: string, posts: CalendarPost[]): void {
      if (!detail) return;
      detail.textContent = "";

      const heading = document.createElement("span");
      heading.className = "mr-2 font-semibold text-base-content/80";
      heading.textContent = `${key} 更新 ${posts.length} 篇：`;
      detail.append(heading);

      posts.forEach((post, index) => {
        if (index > 0) {
          detail.append(document.createTextNode("、"));
        }
        const link = document.createElement("a");
        link.href = post.url;
        link.className = "link link-primary link-hover";
        link.textContent = post.title;
        detail.append(link);
      });
    }

    function render(): void {
      label.textContent = `${viewYear}年${viewMonth + 1}月`;
      grid.textContent = "";
      if (detail) {
        // 换月后清掉上个月点开的详情，避免日期与文章对不上
        clearDetail();
      }

      // 周一作为第一列：JS 的 getDay() 里周日是 0，故 +6 再取模
      const leadingBlanks = (new Date(viewYear, viewMonth, 1).getDay() + 6) % 7;
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

      for (let i = 0; i < leadingBlanks; i += 1) {
        grid.append(document.createElement("span"));
      }

      for (let day = 1; day <= daysInMonth; day += 1) {
        const key = toKey(viewYear, viewMonth, day);
        const posts = postsByDate[key] ?? [];
        const holiday = holidays[key];
        const lunarText = lunarTextOf(viewYear, viewMonth, day);
        const weekday = new Date(viewYear, viewMonth, day).getDay();
        const isWeekend = weekday === 0 || weekday === 6;
        const isToday = key === todayKey;

        // 第二行：优先节日 / 调休状态，其次是农历
        let subText = lunarText;
        let subClass = "text-base-content/65";
        if (holiday) {
          if (holiday.type === "rest") {
            // 只有假期第一天显示节日名，其余显示「休」，避免整排重复三个字
            subText = holiday.first ? holiday.name : "休";
            subClass = "text-error";
          } else {
            subText = "班";
            subClass = "calendar-work";
          }
        }

        const todayClass = isToday ? " font-bold ring-1 ring-primary/50" : "";
        const sharedClass = `relative flex h-9 flex-col items-center justify-center rounded-md leading-none${todayClass}`;

        const solar = document.createElement("span");
        solar.className = `max-w-full text-[0.8rem] ${
          isWeekend && holiday?.type !== "rest" ? "text-error/75" : "text-base-content/80"
        }`;
        solar.textContent = String(day);

        const sub = document.createElement("span");
        sub.className = `mt-0.5 max-w-full truncate text-[0.58rem] ${subClass}`;
        sub.textContent = subText;

        const host = posts.length > 0 ? document.createElement("button") : document.createElement("span");
        host.className =
          posts.length > 0
            ? `${sharedClass} font-semibold text-primary transition-colors duration-200 hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60`
            : sharedClass;
        if (host instanceof HTMLButtonElement) {
          host.type = "button";
        }

        host.append(solar, sub);

        if (posts.length > 0) {
          const dot = document.createElement("span");
          dot.className = "absolute right-1 top-1 h-1 w-1 rounded-full bg-primary";
          dot.setAttribute("aria-hidden", "true");
          host.append(dot);
          host.addEventListener("click", () => showDetail(key, posts));
        }

        const tooltip = holiday
          ? `${key} ${holiday.name}`
          : lunarText
            ? `${key} 农历${lunarText}`
            : key;
        host.setAttribute("title", tooltip);
        if (posts.length > 0) {
          host.setAttribute("aria-label", `${tooltip}，${posts.length} 篇更新`);
        }

        grid.append(host);
      }
    }

    function shiftMonth(step: number): void {
      viewMonth += step;
      if (viewMonth < 0) {
        viewMonth = 11;
        viewYear -= 1;
      } else if (viewMonth > 11) {
        viewMonth = 0;
        viewYear += 1;
      }
      render();
    }

    // onclick 直接赋值，天然幂等：即使脚本因换页被重复绑定也不会叠加监听器
    if (prevButton) prevButton.onclick = () => shiftMonth(-1);
    if (nextButton) nextButton.onclick = () => shiftMonth(1);

    render();

    // 博客不是天天写，当前月往往一次更新都没有；详情区空着会让人以为功能坏了，
    // 所以本月无更新时默认把「最近一次更新」摆出来。
    const keys = Object.keys(postsByDate).sort();
    const latestKey = keys[keys.length - 1];
    if (latestKey && !postsByDate[todayKey]?.length) {
      const latestPosts = postsByDate[latestKey] ?? [];
      if (latestPosts.length > 0 && detail) {
        // 先让 showDetail 清空并填好内容，再把前缀插到最前面
        // （showDetail 开头会 detail.textContent = ""，先插会被清掉）
        showDetail(latestKey, latestPosts);
        const prefix = document.createElement("span");
        prefix.className = "mr-1 text-base-content/65";
        prefix.textContent = "本月暂无更新 · 最近一次：";
        detail.prepend(prefix);
      }
    }
  }

  document.addEventListener("astro:page-load", initHomeCalendar);
</script>

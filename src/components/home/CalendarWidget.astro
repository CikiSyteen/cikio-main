---
import { Icon } from "astro-icon/components";
import WidgetCard from "./WidgetCard.astro";

/**
 * 月视图更新日历小组件。
 *
 * 服务端只渲染骨架（表头 + 空的网格占位 + 图例），网格由客户端脚本按"访客本地当前月"绘制 ——
 * 静态站点在构建期渲染日历时只会画出构建当月的日历，那是错的。
 * 网格给了固定 min-height 占位，所以客户端填充时不会产生布局位移。
 *
 * 有更新的日期会被标上圆点并可点击，点击后在下方列出当天的文章链接；
 * 数据由 index.astro 按本地日期把文章分好组传进来。
 */

export interface CalendarPost {
  title: string;
  url: string;
}

export interface CalendarWidgetProps {
  /** 形如 { "2026-09-25": [{ title, url }] } */
  postsByDate?: Record<string, CalendarPost[]>;
  class?: string;
}

const { postsByDate = {}, class: className = "" } =
  Astro.props as CalendarWidgetProps;

// 周一起始，与中文日历习惯一致
const WEEKDAY_LABELS = ["一", "二", "三", "四", "五", "六", "日"];
const payload = JSON.stringify(postsByDate);
---

<WidgetCard
  id="home-calendar"
  title="更新日历"
  icon="lucide:calendar-days"
  href="/blog/archives"
  hrefLabel="归档"
  class={className}
>
  <div data-calendar class="flex flex-col gap-2">
    <div class="flex items-center justify-between gap-2">
      <button type="button" data-calendar-prev class="btn btn-ghost btn-xs" aria-label="上一个月">
        <Icon name="lucide:chevron-left" class="h-4 w-4" aria-hidden="true" />
      </button>
      <span data-calendar-label class="text-sm font-semibold">—</span>
      <button type="button" data-calendar-next class="btn btn-ghost btn-xs" aria-label="下一个月">
        <Icon name="lucide:chevron-right" class="h-4 w-4" aria-hidden="true" />
      </button>
    </div>

    <div class="grid grid-cols-7 gap-1 text-center text-[0.7rem] text-base-content/45">
      {WEEKDAY_LABELS.map((label) => <span>{label}</span>)}
    </div>

    <!-- 固定高度占位（6 行），避免客户端绘制时产生布局位移 -->
    <div data-calendar-grid class="grid min-h-[10.5rem] grid-cols-7 gap-1 text-center text-xs"></div>

    <p class="flex items-center justify-end gap-1.5 text-[0.7rem] text-base-content/55">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-primary"></span>
      <span>有更新</span>
    </p>

    <div data-calendar-detail class="min-h-[1.25rem] text-[0.7rem] leading-relaxed"></div>
  </div>
</WidgetCard>

<script type="application/json" data-calendar-data is:inline set:html={payload}></script>

<script>
  // 日历完全在客户端绘制：静态构建期算出来的"当月"是构建当月，对访客没有意义。
  interface CalendarPost {
    title: string;
    url: string;
  }

  function initHomeCalendar(): void {
    const root = document.querySelector<HTMLElement>("[data-calendar]");
    if (!root) return;

    const payloadElement = document.querySelector<HTMLScriptElement>("[data-calendar-data]");
    let postsByDate: Record<string, CalendarPost[]> = {};
    try {
      if (payloadElement?.textContent) {
        postsByDate = JSON.parse(payloadElement.textContent) as Record<string, CalendarPost[]>;
      }
    } catch {
      postsByDate = {};
    }

    // 先收窄成非空常量再往下用：闭包里不会再走一遍外层的作用域收窄，
    // 直接把 HTMLElement | null 带进 render() 会报 "possibly null"。
    const gridNode = root.querySelector<HTMLElement>("[data-calendar-grid]");
    const labelNode = root.querySelector<HTMLElement>("[data-calendar-label]");
    if (!gridNode || !labelNode) return;
    const grid: HTMLElement = gridNode;
    const label: HTMLElement = labelNode;

    const detail = root.querySelector<HTMLElement>("[data-calendar-detail]");
    const prevButton = root.querySelector<HTMLButtonElement>("[data-calendar-prev]");
    const nextButton = root.querySelector<HTMLButtonElement>("[data-calendar-next]");

    const today = new Date();
    const todayKey = toKey(today.getFullYear(), today.getMonth(), today.getDate());
    let viewYear = today.getFullYear();
    let viewMonth = today.getMonth();

    function toKey(year: number, month: number, day: number): string {
      return `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
    }

    function clearDetail(): void {
      if (!detail) return;
      detail.textContent = "";
    }

    function showDetail(key: string, posts: CalendarPost[]): void {
      if (!detail) return;
      detail.textContent = "";

      const heading = document.createElement("span");
      heading.className = "mr-2 font-semibold text-base-content/80";
      heading.textContent = `${key} 更新 ${posts.length} 篇：`;
      detail.append(heading);

      posts.forEach((post, index) => {
        if (index > 0) {
          detail.append(document.createTextNode("、"));
        }
        const link = document.createElement("a");
        link.href = post.url;
        link.className = "link link-primary link-hover";
        link.textContent = post.title;
        detail.append(link);
      });
    }

    function render(): void {
      label.textContent = `${viewYear}年${viewMonth + 1}月`;
      grid.textContent = "";
      if (detail) {
        // 换月后清掉上个月点开的详情，避免日期与文章对不上
        clearDetail();
      }

      // 周一作为第一列：JS 的 getDay() 里周日是 0，故 +6 再取模
      const leadingBlanks = (new Date(viewYear, viewMonth, 1).getDay() + 6) % 7;
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

      for (let i = 0; i < leadingBlanks; i += 1) {
        grid.append(document.createElement("span"));
      }

      for (let day = 1; day <= daysInMonth; day += 1) {
        const key = toKey(viewYear, viewMonth, day);
        const posts = postsByDate[key] ?? [];
        const isToday = key === todayKey;
        const todayClass = isToday ? " font-bold ring-1 ring-primary/50" : "";

        if (posts.length > 0) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = `relative flex h-6 items-center justify-center rounded-md font-semibold text-primary transition-colors duration-200 hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60${todayClass}`;
          button.textContent = String(day);
          button.setAttribute(
            "aria-label",
            `${viewYear}年${viewMonth + 1}月${day}日，${posts.length} 篇更新`,
          );

          const dot = document.createElement("span");
          dot.className = "absolute bottom-0.5 h-1 w-1 rounded-full bg-primary";
          dot.setAttribute("aria-hidden", "true");
          button.append(dot);

          button.addEventListener("click", () => showDetail(key, posts));
          grid.append(button);
          continue;
        }

        const cell = document.createElement("span");
        cell.className = `flex h-6 items-center justify-center rounded-md text-base-content/70${todayClass}`;
        cell.textContent = String(day);
        grid.append(cell);
      }
    }

    function shiftMonth(step: number): void {
      viewMonth += step;
      if (viewMonth < 0) {
        viewMonth = 11;
        viewYear -= 1;
      } else if (viewMonth > 11) {
        viewMonth = 0;
        viewYear += 1;
      }
      render();
    }

    // onclick 直接赋值，天然幂等：即使脚本因换页被重复绑定也不会叠加监听器
    if (prevButton) prevButton.onclick = () => shiftMonth(-1);
    if (nextButton) nextButton.onclick = () => shiftMonth(1);

    render();

    // 博客不是天天写，当前月往往一次更新都没有；详情区空着会让人以为功能坏了，
    // 所以本月无更新时默认把「最近一次更新」摆出来。
    const keys = Object.keys(postsByDate).sort();
    const latestKey = keys[keys.length - 1];
    if (latestKey && !postsByDate[todayKey]?.length) {
      const latestPosts = postsByDate[latestKey] ?? [];
      if (latestPosts.length > 0 && detail) {
        // 先让 showDetail 清空并填好内容，再把前缀插到最前面
        // （showDetail 开头会 detail.textContent = ""，先插会被清掉）
        showDetail(latestKey, latestPosts);
        const prefix = document.createElement("span");
        prefix.className = "mr-1 text-base-content/50";
        prefix.textContent = "本月暂无更新 · 最近一次：";
        detail.prepend(prefix);
      }
    }
  }

  document.addEventListener("astro:page-load", initHomeCalendar);
</script>

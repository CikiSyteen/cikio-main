---
import type { HomeBackgroundItem } from "@interfaces/site";

/**
 * 首页的全屏风景壁纸层（参考 type/62296d 的沉浸式背景做法）。
 *
 * 关键取舍：
 *  1. 固定定位 + 负 z-index，压在全部内容之下。它挂在 BaseLayout 的 body 级
 *     `backdrop` 插槽里 —— 内容区外层的 .onload-animation 带常驻 transform，
 *     放进去会把 fixed 的包含块劫持成内容列。
 *  2. 图片是 public/ 下的本地文件，按 `-960` / `-1920` 两个宽度拼 srcset，
 *     不依赖任何外链图床。
 *  3. 两层 <img> 叠放 + 透明度交叉淡入：换图时先把新图放进隐藏层，
 *     等它 load 完再交换透明度，否则改 src 的那一刻会闪一下页面底色。
 *  4. 遮罩按主题分支（样式在 global.scss）：亮色只加一层极薄薄纱，暗色大幅压暗。
 *  5. 选中的图与轮换方式来自访客的 localStorage 设置（齿轮面板写入），
 *     没有设置时退回 config/home.background.yaml 里的默认值。
 *
 * 轮换方式有四种（见 @utils/homeRotation）：不轮换 / 每日 / 每次刷新 / 每 N 秒。
 * 访客显式选过某张图时永远以他的选择为准，上面四种方式只在"没选过"时决定显示哪一张。
 */

export interface HomeBackdropProps {
  backgrounds: HomeBackgroundItem[];
  defaultId: string;
  /** 默认轮换方式，取值见 @utils/homeRotation */
  mode: string;
}

const { backgrounds, defaultId, mode } = Astro.props as HomeBackdropProps;

const active =
  backgrounds.find((item) => item.id === defaultId) ?? backgrounds[0];

/** 静态图按 -960 / -1920 拼 srcset；url 型动态壁纸没有多宽度，交给浏览器 */
const srcsetOf = (item: HomeBackgroundItem) =>
  item.path
    ? `${item.path}-960.webp 960w, ${item.path}-1920.webp 1920w`
    : undefined;
const srcOf = (item: HomeBackgroundItem) =>
  item.url ?? `${item.path}-1920.webp`;
const dimsOf = (item: HomeBackgroundItem) =>
  item.url ? { width: 1920, height: 1080 } : { width: 1920, height: 1280 };
---

<div class="home-backdrop" aria-hidden="true">
  <div class="home-backdrop-layer is-active" data-bg-layer="a">
    {
      active && (
        <img
          src={srcOf(active)}
          srcset={srcsetOf(active)}
          sizes="100vw"
          alt=""
          width={dimsOf(active).width}
          height={dimsOf(active).height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="home-backdrop-image"
          data-bg-image
          data-bg-id={active.id}
        />
      )
    }
  </div>

  <div class="home-backdrop-layer" data-bg-layer="b">
    <img
      alt=""
      width="1920"
      height="1280"
      loading="eager"
      decoding="async"
      class="home-backdrop-image"
      data-bg-image
    />
  </div>

  <!--
    只有一层整体薄纱，没有"收边"渐变：
    顶部导航是浮在壁纸上的半透明胶囊、页脚也是，画面可以真正铺满整屏。
    遮罩的透明度与颜色按 data-theme-type 分支，见 global.scss 的「首页」区块。
  -->
  <div class="home-backdrop-veil"></div>
</div>

<script
  type="application/json"
  data-home-bg-data
  is:inline
  set:html={JSON.stringify({ backgrounds, defaultId, mode })}
></script>

{/*
  首屏防闪：SSR 只能渲染默认壁纸，访客若选了别的图，客户端脚本（astro:page-load）
  才会切换，于是先闪默认再切选中。这里在解析期、首屏绘制前用内联脚本把初始图直接换成
  用户已选的那张，后续的 initBackdrop 会因「当前层已是选中项」而跳过，不再二次切换。
*/}
<script is:inline>
  (function () {
    try {
      var raw = localStorage.getItem("cikio-home-settings");
      if (!raw) return;
      var settings = JSON.parse(raw);
      var bgId = settings && settings.bg;
      if (!bgId) return;

      var dataEl = document.querySelector("[data-home-bg-data]");
      if (!dataEl) return;
      var payload = JSON.parse(dataEl.textContent || "{}");
      var list = payload.backgrounds || [];
      var item = null;
      for (var i = 0; i < list.length; i++) {
        if (list[i].id === bgId) {
          item = list[i];
          break;
        }
      }
      if (!item) return;

      var img = document.querySelector(".home-backdrop-layer.is-active [data-bg-image]");
      if (!img || img.dataset.bgId === bgId) return;

      if (item.url) {
        img.removeAttribute("srcset");
        img.src = item.url + (item.url.indexOf("?") > -1 ? "&" : "?") + "_t=" + Date.now();
      } else {
        img.srcset = item.path + "-960.webp 960w, " + item.path + "-1920.webp 1920w";
        img.src = item.path + "-1920.webp";
      }
      img.dataset.bgId = bgId;
    } catch (e) {
      /* 解析失败就退回 SSR 的默认图，不影响其余功能 */
    }
  })();
</script>

<script>
  import type { Rotation } from "@utils/homeRotation";
  import { dailyRotationIndex, normalizeRotation, parseRotation } from "@utils/homeRotation";

  const SETTINGS_KEY = "cikio-home-settings";

  /** 背景条目：本地静态图带 path，动态壁纸（必应今日/随机）带 url */
  interface BgItem {
    id: string;
    path?: string;
    url?: string;
  }

  interface BgPayload {
    backgrounds: BgItem[];
    defaultId: string;
    mode: string;
  }

  // 当前正在显示的是哪一层；模块级变量在同一次会话内跨站内换页保留
  let activeLayer: "a" | "b" = "a";
  let rotationTimer: number | undefined;

  function readSettings(): { bg?: string; bgMode?: string; bgInterval?: number } {
    try {
      return JSON.parse(window.localStorage.getItem(SETTINGS_KEY) || "{}");
    } catch {
      return {};
    }
  }

  function readPayload(): BgPayload | null {
    const element = document.querySelector<HTMLScriptElement>("[data-home-bg-data]");
    if (!element?.textContent) return null;
    try {
      return JSON.parse(element.textContent);
    } catch {
      return null;
    }
  }

  function layerOf(name: "a" | "b"): HTMLElement | null {
    return document.querySelector<HTMLElement>(`[data-bg-layer="${name}"]`);
  }

  function imageOf(name: "a" | "b"): HTMLImageElement | null {
    return layerOf(name)?.querySelector("img") ?? null;
  }

  function applySource(img: HTMLImageElement, item: BgItem): void {
    img.dataset.bgId = item.id;
    if (item.url) {
      // 动态壁纸（必应今日/随机）：清掉静态 srcset；加时间戳绕过 <img> 的
      // 同 URL 内存缓存 —— 「随机」每次都要真的换一张，302 的 no-cache 只管跳转本身
      img.srcset = "";
      img.src = `${item.url}${item.url.includes("?") ? "&" : "?"}_t=${Date.now()}`;
      return;
    }
    img.srcset = `${item.path}-960.webp 960w, ${item.path}-1920.webp 1920w`;
    img.src = `${item.path}-1920.webp`;
  }

  /**
   * 访客的设置优先于配置。一并兼容旧键 bgInterval（老访客存的是裸秒数）；
   * 背景的 0 按"不轮换"理解 —— 与一言不同，它有明确的默认图。
   */
  function rotationOf(payload: { mode: string }): Rotation {
    const settings = readSettings();
    if (settings.bgMode != null) return parseRotation(settings.bgMode, "none");
    if (settings.bgInterval != null) return parseRotation(settings.bgInterval, "none");
    return parseRotation(normalizeRotation(payload.mode, "none"), "none");
  }

  /** 该显示哪一张：访客显式选过就一直是那张，没选过才交给轮换方式决定 */
  function wantedId(payload: BgPayload): string {
    const settings = readSettings();
    if (payload.backgrounds.some((item) => item.id === settings.bg)) {
      return settings.bg as string;
    }

    const rotation = rotationOf(payload);
    const total = payload.backgrounds.length;
    if (total === 0) return payload.defaultId;
    if (rotation.kind === "refresh") {
      return payload.backgrounds[Math.floor(Math.random() * total)].id;
    }
    if (rotation.kind === "daily") {
      return payload.backgrounds[dailyRotationIndex(new Date(), total)].id;
    }
    return payload.defaultId;
  }

  /** 带过场的切换：首次渲染、齿轮面板改图、以及自动轮换都走这里 */
  function switchWithFade(payload: BgPayload, id: string): void {
    const item = payload.backgrounds.find((entry) => entry.id === id);
    if (!item) return;
    if (imageOf(activeLayer)?.dataset.bgId === id) return;

    const nextName: "a" | "b" = activeLayer === "a" ? "b" : "a";
    const nextLayer = layerOf(nextName);
    const nextImage = imageOf(nextName);
    if (!nextLayer || !nextImage) return;

    applySource(nextImage, item);

    const swap = () => {
      nextLayer.classList.add("is-active");
      layerOf(activeLayer)?.classList.remove("is-active");
      activeLayer = nextName;
    };

    // 新图已经解码完（换回看过的图）就直接切，否则等 load，避免闪一下底色。
    // 动态壁纸要等网络图返回，同样落在这里。
    if (nextImage.complete && nextImage.naturalWidth > 0) {
      swap();
    } else {
      nextImage.addEventListener("load", swap, { once: true });
    }
  }

  /** 只有定时模式需要起定时器；不轮换 / 每日 / 每次刷新都不起 */
  function startRotation(
    payload: BgPayload,
    rotation: Rotation,
  ): void {
    window.clearInterval(rotationTimer);
    rotationTimer = undefined;
    if (rotation.kind !== "timer" || rotation.seconds <= 0) return;
    if (payload.backgrounds.length < 2) return;

    rotationTimer = window.setInterval(() => {
      const current = imageOf(activeLayer)?.dataset.bgId ?? "";
      const index = payload.backgrounds.findIndex((entry) => entry.id === current);
      const next = payload.backgrounds[(index + 1) % payload.backgrounds.length];
      switchWithFade(payload, next.id);
    }, rotation.seconds * 1000);
  }

  function initBackdrop(): void {
    const payload = readPayload();
    if (!payload || payload.backgrounds.length === 0) return;
    // 首次渲染也走带过场的切换：目标与 SSR 渲染的默认图相同时它自己会 no-op；
    // 不同时（访客选过别张 / 轮换选中 / 必应动态壁纸要走网络），等新图 load 完
    // 才交换透明度，SSR 的那张会一直垫底，不会闪出页面底色。
    switchWithFade(payload, wantedId(payload));
    startRotation(payload, rotationOf(payload));
  }

  // 站内换页后 DOM 被换掉，需要在 page-load 重新绑定；齿轮改了设置则即时响应
  document.addEventListener("astro:page-load", initBackdrop);
  window.addEventListener("cikio:home-settings", () => {
    const payload = readPayload();
    if (!payload) return;
    switchWithFade(payload, wantedId(payload));
    startRotation(payload, rotationOf(payload));
  });
</script>

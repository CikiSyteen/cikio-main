---
import { USER_NAME, USER_SITE } from "@config";
import { Icon } from "astro-icon/components";

/**
 * hero 页面专用的轻量页脚。
 *
 * 站点自带的 Footer.astro 是 p-10 的通栏卡片，放在沉浸式 hero 里会把壁纸
 * 从底部整条切掉；参考页（c91d8f）的做法是"只剩一行版权"。
 * 这里做成一条居中的玻璃细胶囊：一行版权 + RSS。
 *
 * 社交图标不在这里重复一份 —— 它们已经放在左栏的身份区（见 HomeHero）。
 */

export interface HomeFooterProps {
  class?: string;
}

const { class: className = "" } = Astro.props as HomeFooterProps;
---

<footer class:list={["home-enter mx-auto w-fit max-w-full", className]}>
  <div
    class="home-footer-bar flex items-center gap-3 rounded-full border border-base-300/40 px-5 py-2"
  >
    <!--
      用 flex + gap 而不是靠文本里的空格分隔：
      @playform/compress 会把元素之间的换行空白折叠掉，
      靠空格排版会压成「© 2026CikiSyteen·Powered by Frosti」。
    -->
    <div class="flex flex-wrap items-center gap-x-1.5 text-xs text-base-content/75">
      <span>© {new Date().getFullYear()}</span>
      <a
        href={USER_SITE}
        class="link link-hover"
        target="_blank"
        rel="noopener noreferrer">{USER_NAME}</a
      >
      <span aria-hidden="true">·</span>
      <span>Powered by</span>
      <a
        href="https://github.com/EveSunMaple/Frosti"
        class="link link-hover"
        target="_blank"
        rel="noopener noreferrer">Frosti</a
      >
    </div>

    <div class="tooltip tooltip-top" data-tip="RSS Feed">
      <a
        href="/rss.xml"
        aria-label="RSS Feed"
        class="flex items-center justify-center rounded-lg text-base-content/70 transition-colors duration-200 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60"
      >
        <Icon name="ri:rss-line" class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>

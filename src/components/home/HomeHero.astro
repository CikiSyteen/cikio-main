---
import { Image } from "astro:assets";
import {
  SITE_DESCRIPTION,
  SITE_TITLE,
  USER_AVATAR,
  USER_BIO,
  USER_NAME,
  USER_SIDEBAR_SOCIAL_ICONS,
} from "@config";
import { Icon } from "astro-icon/components";

/**
 * 首页首屏的身份区。
 *
 * 头像与站名同一行展示（对齐 type/62296d 的 .brand-identity：徽章 + 字标并排），
 * 下方依次是简介、主入口按钮、社交图标。整块**不套卡片**，直接压在壁纸上。
 *
 * 这里原先垫着一块 .home-hero-glow（居中的径向柔光，亮色洗白 / 暗色压暗，
 * 用来给直接压在照片上的文案保底对比度）。按要求已移除：那块柔光在浅色下
 * 是一团发白的椭圆、深色下是一团发黑的椭圆，看起来像"信息区底下压了个影子"。
 * 代价是文案对比度现在完全取决于壁纸本身 —— 若以后换成明暗反差大的背景图，
 * 需要重新评估标题与简介的可读性（或改用文字阴影这类不改变画面观感的做法）。
 *
 * align="start" 用于双栏版式（左身份 / 右小组件群）：lg 起整块靠左对齐；
 * 窄屏仍退回居中的单栏堆叠，避免左侧留一大片空白。
 *
 * 它同时是页面唯一的 h1（其余小组件标题都是 h2）。
 */

export interface HomeHeroProps {
  /** lg 及以上的对齐方式：双栏版式用 start，单栏居中版式用 center */
  align?: "center" | "start";
  class?: string;
}

const { align = "center", class: className = "" } =
  Astro.props as HomeHeroProps;

const isStart = align === "start";

// bio 留空时退回站点描述，避免出现空段落
const intro = USER_BIO || SITE_DESCRIPTION;
---

<section
  aria-labelledby="home-hero-title"
  class:list={[
    // 只有动画类、没有 home-widget：这块刻意不带卡片底板，直接压在壁纸上
    "home-enter flex flex-col gap-5",
    isStart ? "items-center text-center lg:items-start lg:text-left" : "items-center text-center",
    className,
  ]}
>
  <!-- 头像 + 站名同一行 -->
  <div class="flex items-center gap-4">
    <!--
      头像是这一块里唯一的"实体"，用 shadow-xl + 半透明 ring 做悬浮层次：
      阴影是散开的软投影（不是贴边描边），ring 取 base-100 的半透明（浅色偏白、
      深色偏深），在头像与壁纸之间留出一圈"托起"的间隙。
      两者缺一都会贴死在背景上：只有阴影像是墙上的暗斑，只有 ring 像是直接印在图上的贴纸。
    -->
    <Image
      src={USER_AVATAR}
      alt={`${USER_NAME} 的头像`}
      format="webp"
      width={192}
      height={192}
      loading="eager"
      class="h-16 w-16 shrink-0 rounded-2xl object-cover shadow-xl ring-4 ring-base-100/60 sm:h-20 sm:w-20"
    />
    <div class="flex min-w-0 flex-col gap-0.5">
      <p class="home-hero-outline text-xs text-base-content/80 sm:text-sm">你好，欢迎来到</p>
      <h1
        id="home-hero-title"
        class="home-hero-outline-title text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl"
      >
        {SITE_TITLE}
      </h1>
    </div>
  </div>

  <!--
    文字直接压在照片上，透明度不敢压低：中小字号只有靠足量的 base-content
    才撑得住对比度（大字号标题反而有余量）。
    浅色模式下另有一圈外描边（.home-hero-outline*，定义在 global.scss），
    用来补上柔光移除后失去的对比度余量。
  -->
  <p
    class:list={[
      "home-hero-outline max-w-xl text-balance text-sm leading-relaxed text-base-content/90 sm:text-base",
      isStart && "lg:max-w-md",
    ]}
  >
    {intro}
  </p>

  <div
    class:list={[
      "flex flex-wrap items-center gap-3",
      isStart ? "justify-center lg:justify-start" : "justify-center",
    ]}
  >
    <a href="/blog" class="btn btn-primary gap-2">
      <Icon name="lucide:book-open" class="h-4 w-4" aria-hidden="true" />
      <span>进入博客</span>
    </a>
    <a
      href="/about"
      class="btn home-btn-glass gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60"
    >
      <Icon name="lucide:user" class="h-4 w-4" aria-hidden="true" />
      <span>关于我</span>
    </a>
  </div>

  <!--
    社交入口放在身份区（对齐 c91d8f 把 .social-icons 放进左栏的做法），
    这样底部的英雄页脚就只剩一行版权，整页不需要两处重复的社交按钮。
  -->
  <div class="flex flex-wrap items-center justify-center gap-2 lg:justify-start">
    {
      USER_SIDEBAR_SOCIAL_ICONS.map((item) => (
        <div class="tooltip tooltip-bottom" data-tip={item.title}>
          <a
            href={item.href}
            aria-label={item.ariaLabel}
            target="_blank"
            rel="noopener noreferrer"
            class="home-tile flex h-10 w-10 items-center justify-center rounded-xl text-base-content/75 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60"
          >
            <Icon name={item.svg} class="h-5 w-5" aria-hidden="true" />
          </a>
        </div>
      ))
    }
  </div>
</section>

---
import { Image } from "astro:assets";
import {
  SITE_DESCRIPTION,
  SITE_TITLE,
  USER_AVATAR,
  USER_BIO,
  USER_NAME,
} from "@config";
import { Icon } from "astro-icon/components";

/**
 * 首页首屏的身份区。
 *
 * 刻意**不套卡片**：hero 版式里这一块直接压在壁纸上，四周留白，
 * 视觉重心落在头像与站名上；后面才是收窄的小组件带。
 * 可读性交给 global.scss 的 .home-hero-glow —— 一块居中的径向柔光，
 * 既不是卡片也不算遮罩，亮色下把画面洗白、暗色下压暗，壁纸依然完整可见。
 *
 * 它同时是页面唯一的 h1（其余小组件标题都是 h2），并承载通往博客的主入口。
 */

export interface HomeHeroProps {
  class?: string;
}

const { class: className = "" } = Astro.props as HomeHeroProps;

// bio 留空时退回站点描述，避免出现空段落
const intro = USER_BIO || SITE_DESCRIPTION;
---

<section
  aria-labelledby="home-hero-title"
  class:list={[
    // 只有动画类、没有 home-widget：这块刻意不带卡片底板，直接压在壁纸上
    "home-enter relative isolate flex flex-col items-center gap-5 text-center sm:gap-6",
    className,
  ]}
>
  <div class="home-hero-glow" aria-hidden="true"></div>

  <Image
    src={USER_AVATAR}
    alt={`${USER_NAME} 的头像`}
    format="webp"
    width={192}
    height={192}
    loading="eager"
    class="h-24 w-24 rounded-3xl object-cover shadow-xl ring-4 ring-base-100/60 sm:h-28 sm:w-28"
  />

  <!--
    文字直接压在照片上，透明度不敢压低：中小字号只有靠足量的 base-content
    才撑得住对比度（大字号标题反而有余量）。
  -->
  <div class="flex flex-col items-center gap-2">
    <p class="text-sm text-base-content/80">你好，欢迎来到</p>
    <h1
      id="home-hero-title"
      class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
    >
      {SITE_TITLE}
    </h1>
    <p class="mt-2 max-w-xl text-sm leading-relaxed text-base-content/90 sm:text-base">
      {intro}
    </p>
  </div>

  <div class="mt-1 flex flex-wrap items-center justify-center gap-3">
    <a href="/blog" class="btn btn-primary gap-2">
      <Icon name="lucide:book-open" class="h-4 w-4" aria-hidden="true" />
      <span>进入博客</span>
    </a>
    <a
      href="/about"
      class="btn home-btn-glass gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60"
    >
      <Icon name="lucide:user" class="h-4 w-4" aria-hidden="true" />
      <span>关于我</span>
    </a>
  </div>
</section>

---
import { DATE_FORMAT, t, USER_NAME } from "@config";
import type { PostData } from "@interfaces/data";
import dayjs from "@utils/dayjs";
import { Icon } from "astro-icon/components";
import PostFilter from "./PostFilter.astro";

const {
  title,
  description,
  url,
  pubDate,
  badge,
  categories = [],
  tags = [],
  word,
  time,
} = Astro.props as PostData;
const displayDate = pubDate ? dayjs(pubDate).format(DATE_FORMAT) : "";
// 两种 OG 图：原版分享卡片，以及带二维码的分享图（OG 路由的 -qr 变体）
const ogImage = url ? `${String(url).replace("/blog/", "/og/")}.png` : "";
const ogImageQr = ogImage.replace(/\.png$/, "-qr.png");
// 分享渠道：微信没有网页分享接口（只能在微信内用 JS-SDK），所以微信改为"复制链接"按钮
const encodedUrl = encodeURIComponent(String(url));
const encodedTitle = encodeURIComponent(title);
const encodedSummary = encodeURIComponent(description ?? "");
const encodedOgImage = encodeURIComponent(ogImage);
// 保存图片时的文件名
const postSlug = String(url ?? "")
  .split("/")
  .filter(Boolean)
  .pop();
const saveFileBase = postSlug ? `cikio-${postSlug}` : "cikio";
// 弹窗内左右滑动的两张图：切到哪张，保存按钮就保存哪张
const ogSlides = [
  { src: ogImage, label: "分享卡片", saveName: `${saveFileBase}.png` },
  { src: ogImageQr, label: "带二维码", saveName: `${saveFileBase}-qr.png` },
];

const shareLinks = [
  {
    name: "QQ",
    icon: "ri:qq-line",
    class: "bg-[#12b7f5] hover:bg-[#0fa5dd]",
    url: `https://connect.qq.com/widget/shareqq/index.html?url=${encodedUrl}&title=${encodedTitle}&summary=${encodedSummary}&pics=${encodedOgImage}`,
  },
  {
    name: "QQ空间",
    icon: "ri:planet-line",
    class: "bg-[#f5c300] hover:bg-[#e0b200]",
    url: `https://sns.qzone.qq.com/cgi-bin/qzshare/cgi_qzshare_onekey?url=${encodedUrl}&title=${encodedTitle}&summary=${encodedSummary}&pics=${encodedOgImage}`,
  },
  {
    name: "微博",
    icon: "ri:weibo-line",
    class: "bg-[#e6162d] hover:bg-[#cc1327]",
    url: `https://service.weibo.com/share/share.php?url=${encodedUrl}&title=${encodedTitle}&pic=${encodedOgImage}`,
  },
];
---

<hr />
<div class="container p-0">
  <div class="text-right text-sm text-base-content/60 italic mb-2">
    <Icon name="ri:heart-line" class="w-4 h-4 inline-block align-text-bottom text-error" /> 感谢阅读！
  </div>

  <div class="card bg-base-200 overflow-visible">
    <div class="card-body relative p-4 sm:p-6 lg:p-8">
      <!-- License Icon -->
      <div class="absolute -top-8 left-8">
        <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center shadow-lg">
          <Icon name="ri:creative-commons-line" class="w-10 h-10 text-primary-content" />
        </div>
      </div>

      <!-- Article Metadata -->
      <div class="space-y-4">
        <h3 class="text-lg sm:text-xl lg:text-2xl font-bold">{title}</h3>

        <!-- Stats Row -->
        <div class="flex flex-wrap gap-2 sm:gap-4 text-xs sm:text-sm opacity-75">
          {
            displayDate && (
              <span class="flex items-center gap-1">
                <Icon name="lucide:calendar" class="h-4 w-4" />
                {displayDate}
              </span>
            )
          }

          {
            badge && (
              <span class="flex items-center gap-1">
                <Icon name="lucide:bookmark" class="h-4 w-4" />
                {badge}
              </span>
            )
          }

          {
            word && time && (
              <div class="flex items-center gap-1">
                <Icon name="lucide:book-open" class="h-4 w-4" />
                <span>
                  {word} {t("label.wordCount")} · {time} {t("label.readTime")}
                </span>
              </div>
            )
          }
          <a href={url} class="flex items-center gap-1 hover:text-primary transition-colors">
            <Icon name="ri:links-line" class="w-4 h-4" />
          </a>
        </div>

        <!-- Categories and Tags -->
        <div class="mt-4">
          <PostFilter categories={categories} tags={tags} />
          <!-- License Info -->
          <hr class="my-4" />
          <p class="text-sm opacity-75"></p>
          © {USER_NAME} |
          <a
            href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-primary transition-colors"
          >
            CC BY-NC-SA 4.0
          </a>
        </div>
      </div>

      <!-- Share Button -->
      <div class="flex justify-end mt-4">
        <button class="btn btn-primary btn-outline" onclick="share_modal.showModal()">
          {t("label.share")}
          <Icon name="ri:share-line" class="w-5 h-5" />
        </button>
      </div>
    </div>
  </div>

  <!-- Share Modal -->
  <!-- Share Modal -->
  <dialog id="share_modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box max-w-lg rounded-xl">
      <h3 class="font-bold text-base sm:text-lg mb-4 text-center">
        {t("label.shareCard")}
      </h3>

      <!-- 两种 OG 图：左右滑动切换，保存按钮跟随当前展示的那张 -->
      <div class="w-full mb-4">
        <!-- 图片区：左右两侧叠加半透明切换按钮 -->
        <div class="relative">
          <div
            id="og-carousel"
            class="og-carousel flex w-full snap-x snap-mandatory overflow-x-auto scroll-smooth"
          >
            {
              ogSlides.map((slide, index) => (
                <div
                  class="og-slide flex w-full shrink-0 snap-center flex-col items-center gap-2 px-1"
                  data-save-name={slide.saveName}
                >
                  <img
                    src={slide.src}
                    alt={`${slide.label}：${title}`}
                    class="rounded-lg shadow-md max-h-60 object-contain"
                    loading={index === 0 ? "eager" : "lazy"}
                  />
                  <span class="text-xs text-base-content/60">{slide.label}</span>
                </div>
              ))
            }
          </div>

          <!-- 左右切换按钮（双端可用，半透明浮在图片两侧） -->
          <button
            type="button"
            class="og-nav btn btn-circle btn-sm absolute top-1/2 left-1 -translate-y-1/2 border-0 bg-black/35 text-white shadow-lg backdrop-blur-sm transition hover:bg-black/60"
            data-dir="-1"
            aria-label="上一张"
          >
            <Icon name="lucide:chevron-left" class="h-5 w-5" />
          </button>
          <button
            type="button"
            class="og-nav btn btn-circle btn-sm absolute top-1/2 right-1 -translate-y-1/2 border-0 bg-black/35 text-white shadow-lg backdrop-blur-sm transition hover:bg-black/60"
            data-dir="1"
            aria-label="下一张"
          >
            <Icon name="lucide:chevron-right" class="h-5 w-5" />
          </button>
        </div>
        <!-- 指示点：点击即可切换 -->
        <div class="mt-2 flex justify-center gap-2">
          {
            ogSlides.map((slide, index) => (
              <button
                type="button"
                class="og-dot h-2 w-2 rounded-full bg-base-content/30 transition-all duration-200"
                data-index={index}
                aria-label={`查看第 ${index + 1} 张：${slide.label}`}
                aria-current={index === 0 ? "true" : "false"}
              />
            ))
          }
        </div>
      </div>

      <!-- 按钮更小巧，排列紧凑 -->
      <div class="flex flex-wrap gap-3 justify-center">
        <!-- 微信：没有网页分享接口，只能复制链接 -->
        <button
          type="button"
          id="share-wechat-btn"
          class="btn btn-circle btn-md transition-transform hover:scale-110 bg-[#07c160] hover:bg-[#06ad56]"
          title="微信（复制链接）"
        >
          <span class="sr-only">微信（复制链接）</span>
          <Icon name="ri:wechat-line" class="w-5 h-5 text-white" />
        </button>
        {
          shareLinks.map(({ name, icon, class: bgClass, url }) => (
            <a
              href={url}
              class={`btn btn-circle btn-md transition-transform hover:scale-110 ${bgClass}`}
              target="_blank"
              rel="noopener noreferrer"
              title={name}
            >
              <span class="sr-only">{name}</span>
              <Icon name={icon} class="w-5 h-5 text-white" />
            </a>
          ))
        }

        <!-- 保存图片：与其它分享按钮同款的圆形图标，保存当前展示的那张 -->
        <a
          id="share-save-btn"
          href={ogImage}
          download={ogSlides[0].saveName}
          class="btn btn-circle btn-md transition-transform hover:scale-110 bg-primary hover:bg-primary/80"
          title="保存图片"
        >
          <span class="sr-only">保存图片</span>
          <Icon name="lucide:download" class="w-5 h-5 text-white" />
        </a>
      </div>

      <!-- 底部关闭按钮 -->
      <div class="modal-action mt-4">
        <form method="dialog" class="w-full flex justify-center">
          <button class="btn btn-md btn-ghost hover:scale-105 transition-transform">
            {t("label.close")}
          </button>
        </form>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>{t("label.close")}</button>
    </form>

    <!-- 复制结果的 toast 提示（放在 dialog 内，才能浮在弹窗之上） -->
    <div id="share-toast" class="toast toast-top toast-center z-[9999] hidden">
      <div class="alert alert-success">
        <Icon name="lucide:circle-check" class="w-5 h-5" />
        <span id="share-toast-text">链接已复制，去微信粘贴给好友吧</span>
      </div>
    </div>
  </dialog>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    // ---------- 微信：复制链接 + toast 反馈 ----------
    const btn = document.querySelector<HTMLButtonElement>("#share-wechat-btn");
    const toast = document.querySelector<HTMLDivElement>("#share-toast");
    const toastText =
      document.querySelector<HTMLSpanElement>("#share-toast-text");

    if (btn && btn.dataset.bound !== "true") {
      btn.dataset.bound = "true";
      let hideTimer: ReturnType<typeof setTimeout> | null = null;

      // 用 toast 反馈复制结果：成功与失败换不同颜色的 alert
      const showToast = (message: string, isError = false) => {
        if (!toast || !toastText) return;
        toastText.textContent = message;
        const alertBox = toast.querySelector(".alert");
        if (alertBox) {
          alertBox.classList.toggle("alert-success", !isError);
          alertBox.classList.toggle("alert-error", isError);
        }
        toast.classList.remove("hidden");
        if (hideTimer) clearTimeout(hideTimer);
        hideTimer = setTimeout(() => toast.classList.add("hidden"), 2500);
      };

      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          showToast("链接已复制，去微信粘贴给好友吧");
        } catch {
          showToast("复制失败，请手动复制地址栏链接", true);
        }
      });
    }

    // ---------- OG 图轮播：保存按钮跟随当前展示的那张 ----------
    const modal = document.querySelector<HTMLDialogElement>("#share_modal");
    const carousel = document.querySelector<HTMLDivElement>("#og-carousel");
    const saveBtn =
      document.querySelector<HTMLAnchorElement>("#share-save-btn");

    if (
      modal &&
      carousel &&
      saveBtn &&
      carousel.dataset.bound !== "true"
    ) {
      carousel.dataset.bound = "true";
      const slides = Array.from(
        carousel.querySelectorAll<HTMLElement>(".og-slide"),
      );
      const dots = Array.from(
        modal.querySelectorAll<HTMLButtonElement>(".og-dot"),
      );
      const navButtons = Array.from(
        modal.querySelectorAll<HTMLButtonElement>(".og-nav"),
      );
      let activeIndex = 0;

      // 切到第 index 张时：同步保存按钮的 href/download，并更新指示点
      const setActive = (index: number) => {
        activeIndex = index;
        const slide = slides[index];
        const img = slide?.querySelector("img");
        if (slide && img) {
          saveBtn.setAttribute("href", img.getAttribute("src") ?? "");
          saveBtn.setAttribute(
            "download",
            slide.dataset.saveName ?? "cikio.png",
          );
        }

        dots.forEach((dot, i) => {
          const active = i === index;
          dot.classList.toggle("w-5", active);
          dot.classList.toggle("bg-primary", active);
          dot.classList.toggle("w-2", !active);
          dot.classList.toggle("bg-base-content/30", !active);
          dot.setAttribute("aria-current", active ? "true" : "false");
        });
      };

      const currentIndex = () => {
        const width = slides[0]?.offsetWidth || 1;
        const index = Math.round(carousel.scrollLeft / width);
        return Math.min(slides.length - 1, Math.max(0, index));
      };

      // 切换到第 index 张（越界则循环）
      const goTo = (index: number) => {
        const target =
          ((index % slides.length) + slides.length) % slides.length;
        carousel.scrollTo({
          left: target * (slides[0]?.offsetWidth ?? 0),
          behavior: "smooth",
        });
        setActive(target);
      };

      carousel.addEventListener("scroll", () => setActive(currentIndex()), {
        passive: true,
      });

      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => goTo(i));
      });

      // 左右按钮：到头后循环
      navButtons.forEach((navBtn) => {
        navBtn.addEventListener("click", () => {
          const dir = Number(navBtn.dataset.dir) || 1;
          goTo(activeIndex + dir);
        });
      });

      setActive(0);
    }
  });
</script>

<style>
  .modal-backdrop button {
    cursor: default;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  /* OG 图轮播：隐藏横向滚动条，靠滑动与指示点切换 */
  .og-carousel {
    scrollbar-width: none;
  }

  .og-carousel::-webkit-scrollbar {
    display: none;
  }

  /* Remove underlines from PostFilter buttons */
  :global(.card-body .btn-category),
  :global(.card-body .btn-tag) {
    text-decoration: none;
  }
</style>

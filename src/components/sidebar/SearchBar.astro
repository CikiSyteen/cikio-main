---
import { t } from "@config";
import { Icon } from "astro-icon/components";
import WidgetLayout from "./WidgetLayout.astro";

// Fuwari 的侧栏没有搜索（搜索在导航栏），这里保留站内搜索并用同款 widget 外壳
---

<WidgetLayout id="sidebar-search" name={t("label.search")}>
  <form action="/blog/search" method="get" class="relative w-full">
    <input
      type="text"
      name="q"
      placeholder={t("label.searchPlaceholder") || "搜索…"}
      aria-label={t("label.search") || "搜索"}
      class="input input-bordered w-full h-10 pl-10 pr-10 rounded-lg"
    />
    <div
      class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-base-content/50"
    >
      <Icon name="lucide:search" class="w-4 h-4" />
    </div>
    <button
      type="submit"
      class="absolute right-1 top-1/2 -translate-y-1/2 btn btn-ghost btn-sm btn-circle w-8 h-8 min-h-8"
      aria-label={t("label.search") || "搜索"}
    >
      <Icon name="lucide:arrow-right" class="w-4 h-4" />
    </button>
  </form>
</WidgetLayout>

<script>
  // Focus search input when pressing '/' key
  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement;
    if (e.key === "/" && target && target.tagName !== "INPUT" && target.tagName !== "TEXTAREA") {
      e.preventDefault();
      const searchInput = document.querySelector('input[name="q"]');
      if (searchInput) {
        (searchInput as HTMLInputElement).focus();
      }
    }
  });
</script>

---
import { getAllPosts, sortPostsByDate } from "@utils/blogUtils";
import CalendarWidget from "@/components/home/CalendarWidget.astro";
import ClockWeatherWidget from "@/components/home/ClockWeatherWidget.astro";
import HomeBackdrop from "@/components/home/HomeBackdrop.astro";
import HomeFooter from "@/components/home/HomeFooter.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import HomeStats from "@/components/home/HomeStats.astro";
import LatestPostsWidget from "@/components/home/LatestPostsWidget.astro";
import SiteNavWidget from "@/components/home/SiteNavWidget.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

/**
 * 首页 = 全屏风景壁纸 + hero 式小组件舞台。
 *
 * 与站内其余页面共用 BaseLayout，多传一个 hero：
 *  - 隐含收起侧栏（侧栏的分类 / 标签 / 菜单与本页的「站点导航」「最新文章」重复）
 *  - 不渲染通栏的站点页脚，改用本页自带的轻量胶囊页脚
 *  - 在 body 上打 .hero-page，global.scss 据此把顶部导航从通栏白条
 *    改写成浮在壁纸上的居中胶囊
 * SEO、亮暗主题、链接预取、视图过渡照旧继承，因此从首页点进 /blog
 * 只有内容区参与过渡，不会整页重建。
 *
 * 版式取两个参考页的结构，而不是把卡片一列列堆满：
 *  - 双栏主体（对齐 c91d8f）：左栏身份（0.85）· 右栏小组件群（1.15），
 *    左栏文字靠左并垂直居中于更高的右栏旁，中间留出 2.5rem 的间隙给壁纸；
 *    右栏内部是 2×2 的 bento——最新文章占满一行，日期时间与更新日历并排。
 *  - 底部工具带（对齐 62296d）：站点导航不复用卡片外壳，改成"渐隐分隔线 +
 *    一排等宽玻璃瓦片 + 一行次级胶囊"，横贯内容区、只占一行高度。
 * 整块内容限宽 68rem 居中，1440 屏两侧各留约 11rem 的风景。
 */

const allPosts = sortPostsByDate(await getAllPosts());
// 取 4 篇：三列不等宽的版式里这张卡是最宽的一列，5 篇会把卡片拉得比同排高出一大截
const latestPosts = allPosts.slice(0, 4).map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate,
  categories: post.data.categories,
}));

// 「更新日历」用：按日期把文章分组，日历上就能标出哪几天有更新。
// 这里用的是构建机的本地时区，与目标读者（东八区）一致；跨时区访客最多差一天。
function toLocalDateKey(date: Date): string {
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${date.getFullYear()}-${month}-${day}`;
}

const postsByDate: Record<string, { title: string; url: string }[]> = {};
for (const post of allPosts) {
  const key = toLocalDateKey(post.data.pubDate);
  const bucket = postsByDate[key] ?? [];
  bucket.push({ title: post.data.title, url: `/blog/${post.id}` });
  postsByDate[key] = bucket;
}

// 左栏"站点数据"用；分类与标签要跨文章去重，所以用 Set 收一遍
const categoryCount = new Set(
  allPosts.flatMap((post) => post.data.categories ?? []),
).size;
const tagCount = new Set(allPosts.flatMap((post) => post.data.tags ?? [])).size;
---

<BaseLayout title="首页" hero>
  <!-- 走 body 级的 backdrop 插槽：全屏固定层不能放进内容区（见 BaseLayout 的说明） -->
  <HomeBackdrop slot="backdrop" />

  <!--
    hero 舞台：整块限宽 68rem 居中（1440 屏两侧各留约 11rem 的风景），
    纵向分三段（双栏主体 → 底部工具带 → 页脚），段间 gap-10 / lg:gap-12。
  -->
  <div class="mx-auto flex w-full max-w-[68rem] flex-col gap-10 px-4 py-8 lg:gap-12 lg:py-10">
    <!--
      1. 双栏主体：左身份 / 右小组件群（对齐 c91d8f 的 0.9 : 1.1 不对称双栏）。
         - 左栏不再居中，文字靠左；右栏高得多，故用 items-center 让左栏在
           垂直方向居中，形成参考页那种"左侧一块品牌、右侧一片仪表"的关系。
         - 两侧列宽比 0.85 : 1.15，中间留出 ga-10 的间隙让壁纸透上来。
    -->
    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-10">
      <!--
        左栏：身份区 + 站点数据。
        home-stagger 是错峰动画的作用域钩子：延迟按直接子元素的 DOM 顺序递增。
        站点数据不只是信息，也用来把左栏撑到与右栏相近的高度 ——
        右栏有三张卡，左栏只有一块身份区的话会明显左轻右重。
      -->
      <div class="home-stagger flex flex-col gap-6 lg:flex-[0.85]">
        <HomeHero align="start" />
        <HomeStats posts={allPosts.length} categories={categoryCount} tags={tagCount} />
      </div>

      <!--
        右栏：最新文章占满一行，下方日期时间与更新日历并排。
        每个小组件套一层 .home-enter 外壳 —— 错峰动画靠 nth-child 定位，
        而组件自己会往同级输出 <script>（Astro 把内联的模块脚本留在原位置），
        不套壳的话格子的直接子元素就不再是"3 张卡"，
        序号会被脚本元素打乱，错峰顺序随机。外壳同时承接栅格跨列类。
      -->
      <div
        class="home-stagger grid w-full grid-cols-1 items-start gap-4 sm:grid-cols-2 sm:gap-5 lg:flex-[1.15]"
      >
        <div class="home-enter sm:col-span-2">
          <LatestPostsWidget posts={latestPosts} />
        </div>
        <div class="home-enter">
          <ClockWeatherWidget />
        </div>
        <div class="home-enter">
          <CalendarWidget postsByDate={postsByDate} />
        </div>
      </div>
    </div>

    <!-- 2. 底部工具带：横贯内容区的一排入口瓦片（对齐 62296d 的 lower-toolbelt-layer） -->
    <SiteNavWidget class="home-enter-late" />

    <!-- 3. 轻量页脚：一条居中的玻璃胶囊 -->
    <HomeFooter class="home-enter-late" />
  </div>
</BaseLayout>

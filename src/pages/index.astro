---
import {
  HOME_BACKGROUND_DEFAULT,
  HOME_BACKGROUND_INTERVAL,
  HOME_BACKGROUNDS,
  HOME_HOLIDAYS,
  HOME_QUOTE_INTERVAL,
  HOME_QUOTES,
} from "@config";
import { getAllPosts, sortPostsByDate } from "@utils/blogUtils";
import { buildLunarTable } from "@utils/lunar";
import CalendarWidget from "@/components/home/CalendarWidget.astro";
import ClockWeatherWidget from "@/components/home/ClockWeatherWidget.astro";
import HomeBackdrop from "@/components/home/HomeBackdrop.astro";
import HomeFooter from "@/components/home/HomeFooter.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import HomeSettings from "@/components/home/HomeSettings.astro";
import HomeStats from "@/components/home/HomeStats.astro";
import LatestPostsWidget from "@/components/home/LatestPostsWidget.astro";
import RandomQuoteWidget from "@/components/home/RandomQuoteWidget.astro";
import SiteNavWidget from "@/components/home/SiteNavWidget.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

/**
 * 首页 = 全屏风景壁纸 + hero 式小组件舞台。
 *
 * 与站内其余页面共用 BaseLayout，多传一个 hero：
 *  - 隐含收起侧栏（侧栏的分类 / 标签 / 菜单与本页的「站点导航」「最新文章」重复）
 *  - 不渲染通栏的站点页脚，改用本页自带的轻量胶囊页脚
 *  - 在 body 上打 .hero-page，global.scss 据此把顶部导航从通栏白条
 *    改写成浮在壁纸上的居中胶囊
 * SEO、亮暗主题、链接预取、视图过渡照旧继承。
 *
 * 版式分三段（对齐 type/62296d 与 c91d8f 的结构）：
 *  1. 上半区：左栏是身份（头像与站名同行）+ 站点数据，
 *     右栏是"小卡片群"—— 日期时间与天气 / 日历 / 随机一言 的 2×2 bento；
 *     两列不等宽（0.85 : 1.15）并都对齐到顶部。
 *  2. 下半区：通栏的"大卡片"（最新文章），信息量最大的一张单独占一行。
 *  3. 底部工具带（站点导航）与轻量页脚。
 *
 * 所有"可选项"都来自 home.config.yaml：背景图列表、每日一言内容、节假日与调休。
 * 访客在右上角齿轮面板里的选择覆盖配置里的默认值（存 localStorage）。
 */

const currentYear = new Date().getFullYear();
// 去年起算 5 年：访客往前翻一个月、往后翻几年都有农历可看
const lunarTable = buildLunarTable(currentYear - 1, 5);

const allPosts = sortPostsByDate(await getAllPosts());
// 通栏大卡片的高度靠条目数撑：5 篇在 68rem 宽度下正好一行一条
const latestPosts = allPosts.slice(0, 5).map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate,
}));

// 「日历」用：按日期把文章分组，日历上就能标出哪几天有更新。
// 这里用的是构建机的本地时区，与目标读者（东八区）一致；跨时区访客最多差一天。
function toLocalDateKey(date: Date): string {
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${date.getFullYear()}-${month}-${day}`;
}

const postsByDate: Record<string, { title: string; url: string }[]> = {};
for (const post of allPosts) {
  const key = toLocalDateKey(post.data.pubDate);
  const bucket = postsByDate[key] ?? [];
  bucket.push({ title: post.data.title, url: `/blog/${post.id}` });
  postsByDate[key] = bucket;
}

// 左栏"站点数据"用；分类与标签要跨文章去重，所以用 Set 收一遍
const categoryCount = new Set(
  allPosts.flatMap((post) => post.data.categories ?? []),
).size;
const tagCount = new Set(allPosts.flatMap((post) => post.data.tags ?? [])).size;
---

<BaseLayout title="首页" hero>
  <!--
    全屏壁纸与右上角齿轮都走 body 级的 overlay 插槽：
    它们是 position: fixed，而内容区外层的 .onload-animation 带常驻 transform，
    留在内容区里会把 fixed 的包含块劫持成内容列（见 BaseLayout 的说明）。
  -->
  <HomeBackdrop
    slot="overlay"
    backgrounds={HOME_BACKGROUNDS}
    defaultId={HOME_BACKGROUND_DEFAULT}
    interval={HOME_BACKGROUND_INTERVAL}
  />

  <!-- 右上角齿轮：改背景图与轮换间隔，只写 localStorage，不动服务端 -->
  <HomeSettings
    slot="overlay"
    backgrounds={HOME_BACKGROUNDS}
    defaultBackground={HOME_BACKGROUND_DEFAULT}
    backgroundInterval={HOME_BACKGROUND_INTERVAL}
    quoteInterval={HOME_QUOTE_INTERVAL}
  />

  <!-- 整块限宽 68rem 居中，1440 屏两侧各留约 11rem 的风景 -->
  <div class="mx-auto flex w-full max-w-[68rem] flex-col gap-10 px-4 py-8 lg:gap-12 lg:py-10">
    <!--
      上半区：左栏身份 / 右栏小卡片群。
      两栏都用 lg:items-start 对齐到顶部 —— 身份区不再垂直居中，
      否则在更高的右栏旁边会被顶到页面中段、显得偏低。
    -->
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-10">
      <!--
        左栏：身份区 + 站点数据。
        home-stagger 是错峰动画的作用域钩子：延迟按直接子元素的 DOM 顺序递增。
      -->
      <div class="home-stagger flex flex-col gap-6 lg:flex-[0.85]">
        <HomeHero align="start" />
        <HomeStats posts={allPosts.length} categories={categoryCount} tags={tagCount} />
      </div>

      <!--
        右栏：小卡片群，2×2 的 bento —— 左侧一列是日期时间与一言，右侧是日历。
        日历带农历与调休、纵向最高，所以给它 sm:row-span-2 跨两行。

        这里刻意不写 items-start，用栅格默认的 align-items: stretch：
        左列两张卡会被拉伸填满各自那一行，于是卡与卡的上下间距恒等于 gap，
        且「一言」的下边缘与日历的下边缘齐平，不会在卡下面留半截空白。
        注意拉伸的是栅格项（外面那层 .home-enter 外壳），里面的卡片要自己
        加 h-full 才吃得到这个高度。

        每个小组件都套一层 .home-enter 外壳 —— 错峰动画靠 nth-child 定位，
        而组件自己会往同级输出 <script>（Astro 把内联的模块脚本留在原位置），
        不套壳的话格子的直接子元素就不再是"三张卡"，序号会被脚本元素打乱。
        窄屏退回单列时按 DOM 顺序堆叠：时钟 → 日历 → 一言。
      -->
      <div class="home-stagger grid w-full grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:flex-[1.15]">
        <div class="home-enter sm:col-start-1 sm:row-start-1">
          <ClockWeatherWidget class="h-full" />
        </div>
        <div class="home-enter sm:col-start-2 sm:row-span-2 sm:row-start-1">
          <CalendarWidget
            postsByDate={postsByDate}
            lunar={lunarTable}
            holidays={HOME_HOLIDAYS}
          />
        </div>
        {
          HOME_QUOTES.length > 0 && (
            <div class="home-enter sm:col-start-1 sm:row-start-2">
              <RandomQuoteWidget
                quotes={HOME_QUOTES}
                interval={HOME_QUOTE_INTERVAL}
                class="h-full"
              />
            </div>
          )
        }
      </div>
    </div>

    <!--
      下半区：信息量最大的"大卡片"单独占一整行。
      入场动画挂在区块根节点上（分隔线 + 标题 + 卡片一起淡入），
      所以卡片自己用 animate={false} 关掉了重复的一层。
      注意 .home-enter-mid 只提供 animation-delay，必须与 .home-enter 一起用，
      单独写它不会有任何动画。
    -->
    <LatestPostsWidget posts={latestPosts} class="home-enter home-enter-mid" />

    <!-- 底部工具带：横贯内容区的一排入口瓦片（对齐 62296d 的 lower-toolbelt-layer） -->
    <SiteNavWidget class="home-enter-late" />

    <!-- 轻量页脚：一条居中的玻璃胶囊 -->
    <HomeFooter class="home-enter-late" />
  </div>
</BaseLayout>

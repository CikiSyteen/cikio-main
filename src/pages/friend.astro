---
// 友链 / 友站 / 常用资源分别来自 config/ 下的独立配置文件：
// friend.links.yaml、friend.sites.yaml、friend.resources.yaml
import { FRIEND_LINKS, FRIEND_RESOURCES, FRIEND_SITES } from "@config";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import FriendCard from "@/components/mdx/FriendCard.astro";
import LinkCard from "@/components/mdx/LinkCard.astro";
import Showcase from "@/components/mdx/Showcase.astro";
import CardGroup from "@/components/temple/CardGroup.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="友链">
  <CardGroup cols="1">
    <MainCard
      title="友链与资源"
      description="友链，以及一些常用的链接与资源。"
      textOverlay="FRIENDS"
      infoIcon="lucide:link"
    >
      <div class="space-y-10">
        <!-- 友链区块：friends 数组有内容时自动渲染，为空时显示提示 -->
        <section>
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <Icon name="lucide:users" class="w-6 h-6 text-primary" />
            <span>友链</span>
          </h2>

          {
            FRIEND_LINKS.length > 0 ? (
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                {FRIEND_LINKS.map((friend) => (
                  <FriendCard
                    name={friend.name}
                    avatar={friend.avatar}
                    description={friend.description}
                    url={friend.url}
                    type="friend"
                  />
                ))}
              </div>
            ) : (
              <p class="text-base-content/70">还没有添加友链，欢迎联系我交换友链。</p>
            )
          }
        </section>

        <!-- 友站区块：sites 数组有内容时渲染徽章，为空时显示占位 -->
        <section>
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <Icon name="lucide:layout-template" class="w-6 h-6 text-primary" />
            <span>友站</span>
          </h2>

          {
            FRIEND_SITES.length > 0 ? (
              <div class="flex flex-wrap items-center gap-3">
                {FRIEND_SITES.map((site) => (
                  <Showcase name={site.name} url={site.url} />
                ))}
              </div>
            ) : (
              <p class="text-base-content/70">还没有收录友站，欢迎联系我。</p>
            )
          }
        </section>

        <!-- Useful Resources Section -->
        <section>
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <Icon name="lucide:bookmark" class="w-6 h-6 text-primary" />
            <span>常用资源</span>
          </h2>

          {
            FRIEND_RESOURCES.length > 0 ? (
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {FRIEND_RESOURCES.map((resource) => (
                  <LinkCard
                    title={resource.title}
                    desc={resource.desc}
                    url={resource.url}
                    icon={resource.icon}
                    img={resource.img}
                    badge={resource.badge}
                    categories={resource.categories}
                  />
                ))}
              </div>
            ) : (
              <p class="text-base-content/70">还没有添加常用资源。</p>
            )
          }
        </section>

        <div class="divider my-8">
          <Icon name="lucide:heart" class="w-10 h-10 text-primary" />
        </div>

        <div class="text-center">
          <p class="text-base-content/80 mb-4">
            想出现在这个页面上？欢迎联系我交换友链。
          </p>
          <a
            href="https://github.com/CikiSyteen"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary gap-2"
          >
            <Icon name="lucide:github" class="w-5 h-5" />
            <span>在 GitHub 上关注我</span>
          </a>
        </div>
      </div>
    </MainCard>
  </CardGroup>
</BaseLayout>

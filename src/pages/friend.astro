---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import FriendCard from "@/components/mdx/FriendCard.astro";
import LinkCard from "@/components/mdx/LinkCard.astro";
import CardGroup from "@/components/temple/CardGroup.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

// 友链列表：以后加人时在这里追加一项即可（name / avatar / description / url）
const friends: { name: string; avatar: string; description: string; url: string }[] = [];
---

<BaseLayout title="友链">
  <CardGroup cols="1">
    <MainCard
      title="友链与资源"
      description="友链，以及一些常用的链接与资源。"
      textOverlay="FRIENDS"
      infoIcon="lucide:link"
    >
      <div class="space-y-10">
        <!-- 友链区块：friends 数组有内容时自动渲染，为空时显示提示 -->
        <section>
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <Icon name="lucide:users" class="w-6 h-6 text-primary" />
            <span>友链</span>
          </h2>

          {
            friends.length > 0 ? (
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                {friends.map((friend) => (
                  <FriendCard
                    name={friend.name}
                    avatar={friend.avatar}
                    description={friend.description}
                    url={friend.url}
                    type="friend"
                  />
                ))}
              </div>
            ) : (
              <p class="text-base-content/70">还没有添加友链，欢迎联系我交换友链。</p>
            )
          }
        </section>

        <!-- Useful Resources Section -->
        <section>
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <Icon name="lucide:bookmark" class="w-6 h-6 text-primary" />
            <span>常用资源</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <LinkCard
              title="Astro 官方文档"
              desc="Astro 的官方文档，从入门到进阶技巧都有。"
              url="https://docs.astro.build"
              icon="simple-icons:astro"
              categories={["文档", "学习", "参考"]}
            />

            <LinkCard
              title="Tailwind CSS 文档"
              desc="了解如何用 Tailwind 的工具类写样式，不必手写 CSS。"
              url="https://tailwindcss.com/docs"
              icon="simple-icons:tailwindcss"
              categories={["文档", "CSS", "参考"]}
            />

            <LinkCard
              title="daisyUI 组件库"
              desc="浏览 daisyUI 的组件库，学习在项目中的用法。"
              url="https://daisyui.com/components/"
              icon="simple-icons:daisyui"
              categories={["组件", "UI", "参考"]}
            />

            <LinkCard
              title="TypeScript 手册"
              desc="TypeScript 官方手册，系统讲解这门语言。"
              url="https://www.typescriptlang.org/docs/handbook/intro.html"
              icon="simple-icons:typescript"
              categories={["文档", "TypeScript", "参考"]}
            />
          </div>
        </section>

        <div class="divider my-8">
          <Icon name="lucide:heart" class="w-10 h-10 text-primary" />
        </div>

        <div class="text-center">
          <p class="text-base-content/80 mb-4">
            想出现在这个页面上？欢迎联系我交换友链。
          </p>
          <a
            href="https://github.com/CikiSyteen"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary gap-2"
          >
            <Icon name="lucide:github" class="w-5 h-5" />
            <span>在 GitHub 上关注我</span>
          </a>
        </div>
      </div>
    </MainCard>
  </CardGroup>
</BaseLayout>

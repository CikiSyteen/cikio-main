{
  "name": "frosti",
  "type": "module",
  "version": "4.0.0",
  "description": "A clean, elegant, and fast static blog template built with Astro.",
  "license": "GPL-3.0",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "astro-check": "astro check",
    "build": "astro check && astro build && pagefind --site dist",
    "search:clean": "node -e \"require('node:fs').rmSync('public/pagefind',{recursive:true,force:true})\"",
    "search:index": "npm run build && cpy 'dist/pagefind/**' public/pagefind",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check --write ./src",
    "biome:check": "biome check ./src",
    "biome:format": "biome format ./src",
    "biome:summary": "biome check --reporter summary ./src",
    "format": "biome format --write ./src",
    "check-all": "pnpm astro-check && pnpm biome:check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^6.0.2",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@playform/compress": "^0.2.5",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "^7.3.3",
    "astro-expressive-code": "^0.44.2",
    "astro-icon": "^1.2.0",
    "astro-vtbot": "^3.1.0",
    "dayjs": "^1.11.23",
    "js-yaml": "^5.4.2",
    "katex": "^0.16.25",
    "mdast-util-to-string": "^4.0.0",
    "qrcode-generator": "^2.0.4",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "tailwindcss": "^3.4.18",
    "unified": "^11.0.5",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.14",
    "@iconify-json/logos": "^1.2.14",
    "@iconify-json/lucide": "^1.2.134",
    "@iconify-json/material-symbols": "^1.2.92",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.96",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/json": "^2.2.530",
    "@iconify/tailwind": "^1.2.0",
    "@pagefind/default-ui": "^1.5.2",
    "@types/mdast": "^4.0.4",
    "cpy-cli": "^7.0.0",
    "daisyui": "^4.12.24",
    "pagefind": "^1.5.2",
    "sass-embedded": "^1.104.1",
    "typescript": "^5.9.3"
  }
}
